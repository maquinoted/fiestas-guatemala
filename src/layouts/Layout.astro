---
// src/layouts/Layout.astro
import '../styles/global.css';
import { sql } from '@vercel/postgres';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
	ogImage?: string;
	ogImageAlt?: string;
}

const { title, description, noindex = false, ogImage, ogImageAlt } = Astro.props;
let siteName = 'FiestasGuatemala.com';
let siteDescription = 'Explora proveedores para bodas, cumpleaños y celebraciones en Guatemala.';
try {
  const { rows } = await sql`SELECT setting_key, setting_value FROM site_settings WHERE setting_key IN ('site_name', 'site_description')`;
  for (const setting of rows) {
    if (setting.setting_key === 'site_name' && setting.setting_value) siteName = setting.setting_value;
    if (setting.setting_key === 'site_description' && setting.setting_value) siteDescription = setting.setting_value;
  }
} catch { /* Defaults are used until the admin settings schema is initialized. */ }
const metaDescription = description || siteDescription;
const siteBase = 'https://fiestasguatemala.com';
const pageTitle = title.toLocaleLowerCase('es').includes(siteName.toLocaleLowerCase('es')) ? title : `${title} | ${siteName}`;
const isNoindex = noindex || Astro.url.pathname.startsWith('/sys-config-gt') || Astro.url.pathname.startsWith('/api/') || Astro.url.pathname.startsWith('/search') || Astro.url.pathname === '/404';
const canonicalUrl = `${siteBase}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{pageTitle}</title>
		<meta name="description" content={metaDescription} />
		<meta name="robots" content={isNoindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage || `${siteBase}/Logo-Fiestas-Guatemala.jpg`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImage || `${siteBase}/Logo-Fiestas-Guatemala.jpg`} />
		{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
		{!isNoindex && <link rel="canonical" href={canonicalUrl} />}
		<link rel="icon" type="image/png" href="/favicon.png" />
		<slot name="head" />
	</head>
	<body class="bg-[#f0efec] text-[#243447] min-h-screen font-sans antialiased">
		<slot />
	</body>
</html>