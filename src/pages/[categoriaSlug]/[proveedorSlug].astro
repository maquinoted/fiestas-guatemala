---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { sql } from '@vercel/postgres';
import { optimizedImageSrc, optimizedImageSrcSet } from '../../lib/optimizedImage';
import { ensureProviderApplicationSchema } from '../../lib/provider-applications';

const { categoriaSlug, proveedorSlug } = Astro.params;
await ensureProviderApplicationSchema();

let p = null;
let vecinos = [];

try {
  const { rows } = await sql`
    SELECT p.*, c.icono as categoria_emoji, c.nombre as categoria_nombre
    FROM proveedores p
    LEFT JOIN categorias c ON p.categoria_slug = c.slug
    WHERE p.slug = ${proveedorSlug} AND p.activo = true LIMIT 1
  `;
  p = rows[0];

  if (p) {
    const { rows: vRows } = await sql`
      SELECT nombre, slug, imagen_url FROM proveedores 
      WHERE categoria_slug = ${categoriaSlug} AND municipio = ${p.municipio} 
      AND slug != ${p.slug} AND activo = true LIMIT 3
    `;
    vecinos = vRows || [];
  }
} catch (e) { console.error(e); }

if (!p) return Astro.redirect('/404');
if (p.categoria_slug !== categoriaSlug) return Astro.redirect(`/${p.categoria_slug}/${p.slug}`, 301);

const siteBase = 'https://fiestasguatemala.com';
const canonicalURL = `${siteBase}/${categoriaSlug}/${proveedorSlug}`;

const filenameWithExt = p.imagen_url ? p.imagen_url.split('/').pop() : null;
const proxyImageUrl = filenameWithExt ? `${siteBase}/api/image/${filenameWithExt}` : `${siteBase}/placeholder.jpg`;

const tituloSEO = `${p.nombre} en ${p.municipio || p.departamento} | FiestasGuatemala.com`;
const metaDesc = `Contacta a ${p.nombre}, proveedor de ${p.categoria_nombre || 'eventos'} en ${p.municipio || p.departamento}, Guatemala. Consulta disponibilidad y solicita una cotización directamente.`;
const textoWA = encodeURIComponent(`Hola ${p.nombre}, vi tu perfil en FiestasGuatemala.com y me interesa cotizar para un evento.`);

const h1Texto = `${p.nombre} en ${p.municipio}, ${p.departamento}`;

const schemaMarkup = [
  { "@context": "https://schema.org", "@type": "LocalBusiness", "name": p.nombre, "image": proxyImageUrl, "telephone": p.telefono || undefined, "address": { "@type": "PostalAddress", "addressLocality": p.municipio || undefined, "addressRegion": p.departamento || undefined, "addressCountry": "GT" } },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": `¿Cómo contactar a ${p.nombre}?`, "acceptedAnswer": { "@type": "Answer", "text": `Puedes contactar a ${p.nombre} por WhatsApp o teléfono para consultar disponibilidad y solicitar una cotización.` } }] },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteBase }, { "@type": "ListItem", "position": 2, "name": p.categoria_nombre, "item": `${siteBase}/${categoriaSlug}` }, { "@type": "ListItem", "position": 3, "name": p.nombre, "item": canonicalURL }] }
];
---

<Layout title={tituloSEO} description={metaDesc} ogImage={proxyImageUrl} ogImageAlt={p.nombre}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} slot="head" />
  

  <div class="bg-[#F8F7F4] min-h-screen font-sans text-[#243447]">
    <Header />
    
    <main class="max-w-5xl mx-auto pt-4 md:pt-6 pb-20 px-4">
      
      <header class="mb-4 md:mb-6">
        <h1 class="text-2xl md:text-4xl font-sans font-bold text-[#243447] tracking-tight leading-tight">
          {h1Texto}
        </h1>
        <nav class="flex items-center gap-2 text-[9px] uppercase tracking-widest text-[#705930] font-black">
          <a href="/" class="hover:text-[#243447]">Inicio</a> <span>/</span> 
          <a href={`/${categoriaSlug}`}>{p.categoria_nombre}</a> <span>/</span> 
          <span class="text-[#243447] font-bold">{p.nombre}</span>
        </nav>
      </header>

      <div class="bg-white rounded-[40px] md:rounded-[50px] shadow-[0_20px_60px_-15px_rgba(0,0,0,0.1)] overflow-hidden border border-white">
        <div class="grid grid-cols-1 md:grid-cols-12">
          
          <div class="md:col-span-5 relative aspect-square md:aspect-auto bg-gray-50">
            <img 
              src={optimizedImageSrc(p.imagen_url, 800)}
              srcset={optimizedImageSrcSet(p.imagen_url)}
              sizes="(max-width: 767px) calc(100vw - 2rem), (max-width: 1023px) 42vw, 27rem"
              class="foto-proveedor w-full h-full object-cover"
              alt={p.nombre}
              width="800"
              height="800"
              fetchpriority="high"
              loading="eager"
              decoding="async"
            />
            {p.verificado && (
              <div class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-white/95 backdrop-blur-sm px-3 py-1.5 rounded-full shadow-md text-[8px] font-black uppercase tracking-widest text-[#243447]">
                <span aria-hidden="true" class="text-emerald-600">✓</span> Proveedor verificado
              </div>
            )}
          </div>

          <div class="md:col-span-7 p-6 md:p-10 flex flex-col justify-center space-y-6">
            <div class="space-y-2">
              <p class="text-[9px] font-black uppercase tracking-[0.2em] text-[#705930]">
                📍 {p.municipio}, {p.departamento}
              </p>
              {p.direccion && <p class="text-sm text-gray-500">Dirección: {p.direccion}</p>}
              <p class="text-lg md:text-xl font-sans font-medium text-[#243447] leading-snug">
                {p.descripcion}
              </p>
            </div>
            
            <nav aria-label="Redes sociales y favoritos" class="flex w-full items-stretch gap-2 border-t border-gray-100 pt-4">
              {p.instagram_url && <a href={p.instagram_url} target="_blank" rel="noopener noreferrer" aria-label={`Instagram de ${p.nombre}`} class="flex min-h-12 min-w-0 flex-1 items-center justify-center gap-1 rounded-xl bg-gradient-to-r from-[#833AB4] via-[#E1306C] to-[#FCAF45] px-2 py-3 text-center text-xs font-bold text-white"><span aria-hidden="true">◎</span><span class="truncate">Instagram</span></a>}
              {p.tiktok_url && <a href={p.tiktok_url} target="_blank" rel="noopener noreferrer" aria-label={`TikTok de ${p.nombre}`} class="flex min-h-12 min-w-0 flex-1 items-center justify-center gap-1 rounded-xl bg-[#111] px-2 py-3 text-center text-xs font-bold text-white"><span aria-hidden="true">♪</span><span class="truncate">TikTok</span></a>}
              <a href={`/cuenta?guardar=${p.id}`} class="flex min-h-12 min-w-0 flex-1 items-center justify-center gap-1 rounded-xl border border-[#243447]/20 bg-white px-2 py-3 text-center text-xs font-bold text-[#243447] hover:bg-[#f5f4f1]">
                <span aria-hidden="true" class="text-lg leading-none">♡</span><span class="truncate">Guardar favorito</span>
              </a>
            </nav>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
              <a id="btn-wa" href={`https://wa.me/502${p.whatsapp || p.telefono}?text=${textoWA}`} class="bg-[#12833c] text-white py-4 rounded-xl text-center font-black text-[10px] uppercase tracking-widest shadow-lg hover:translate-y-[-1px] transition-all">
                Escribir por WhatsApp
              </a>
              <a id="btn-call" href={`tel:+502${p.telefono}`} class="bg-[#243447] text-white py-4 rounded-xl text-center font-black text-[10px] uppercase tracking-widest transition-all">
                Llamar Ahora
              </a>
            </div>

                {p.tiktok_url && (
                  <a href={p.tiktok_url} target="_blank" rel="noopener noreferrer" aria-label={`Visitar TikTok de ${p.nombre}`} class="group inline-flex items-center gap-2.5 rounded-2xl bg-[#111111] px-5 py-3 text-sm font-bold text-white shadow-md shadow-cyan-400/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-cyan-400/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 focus-visible:ring-offset-2">
                    <svg aria-hidden="true" viewBox="0 0 448 512" class="h-5 w-5 overflow-visible">
                      <path fill="#25F4EE" transform="translate(-8 4)" d="M448,209.91a210.06,210.06,0,0,1-122.77-39.53V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0h88a121.18,121.18,0,0,0,1.86,22.17A122.18,122.18,0,0,0,381,104.69a121.43,121.43,0,0,0,67,20.14Z" />
                      <path fill="#FE2C55" transform="translate(8 -4)" d="M448,209.91a210.06,210.06,0,0,1-122.77-39.53V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0h88a121.18,121.18,0,0,0,1.86,22.17A122.18,122.18,0,0,0,381,104.69a121.43,121.43,0,0,0,67,20.14Z" />
                      <path fill="currentColor" d="M448,209.91a210.06,210.06,0,0,1-122.77-39.53V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0h88a121.18,121.18,0,0,0,1.86,22.17A122.18,122.18,0,0,0,381,104.69a121.43,121.43,0,0,0,67,20.14Z" />
                    </svg>
                    <span>TikTok</span>
                    <span aria-hidden="true" class="text-white/80">↗</span>
                  </a>
                )}
              </nav>
            )}
          </div>
        </div>
      </div>

      {vecinos.length > 0 && (
        <section class="mt-12 md:mt-16">
          <h2 class="text-xl font-sans font-bold text-[#243447] mb-6 border-b border-gray-100 pb-4">Más {p.categoria_nombre} en {p.municipio}</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-8">
            {vecinos.map(v => (
              <a href={`/${categoriaSlug}/${v.slug}`} class="group">
                <div class="bg-white p-2 rounded-[30px] shadow-sm border border-white transition-all group-hover:shadow-md">
                  <div class="aspect-square rounded-[22px] overflow-hidden mb-3 bg-gray-50">
                    <img
                      src={optimizedImageSrc(v.imagen_url, 400)}
                      srcset={optimizedImageSrcSet(v.imagen_url)}
                      sizes="(max-width: 640px) 45vw, 240px"
                      class="foto-proveedor w-full h-full object-cover group-hover:scale-105 transition-transform"
                      alt={v.nombre}
                      width="400"
                      height="400"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <h3 class="font-sans font-bold text-sm text-[#243447] px-1 truncate">{v.nombre}</h3>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>
    <Footer />
  </div>

  <style>
    .foto-proveedor {
      aspect-ratio: 1 / 1;
      width: 100%;
      height: auto;
      content-visibility: auto;
      display: block;
    }
    
    @media (min-width: 768px) {
      .md\:aspect-auto .foto-proveedor {
        aspect-ratio: auto;
        min-height: 400px;
      }
    }
  </style>

</Layout>

<script define:vars={{ pId: p.id }}>
  // 🔥 LÓGICA DE TRACKING ULTRA-EFICIENTE
  const track = (tipo) => {
    const data = JSON.stringify({ proveedorId: pId, tipo });
    
    // Usamos sendBeacon si está disponible (es asíncrono y no bloquea la red)
    if (navigator.sendBeacon) {
      navigator.sendBeacon('/api/click', data);
    } else {
      fetch('/api/click', { 
        method: 'POST', 
        headers: { 'Content-Type': 'application/json' }, 
        body: data, 
        keepalive: true 
      }).catch(() => {});
    }
  };
  
  // Clics: Interacción del usuario
  document.getElementById('btn-wa')?.addEventListener('click', () => track('whatsapp'));
  document.getElementById('btn-call')?.addEventListener('click', () => track('llamada'));
  
  // Vista: Solo cuando el navegador esté libre (Idle)
  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(() => {
      track('vista');
    });
  } else {
    window.addEventListener('load', () => {
      setTimeout(() => track('vista'), 2000);
    });
  }
</script>