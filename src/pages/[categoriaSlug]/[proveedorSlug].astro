---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getProviderPlan } from '../../lib/provider-plans';
import { isSameOriginRequest } from '../../lib/admin-auth';
import { sql } from '@vercel/postgres';
import { optimizedImageSrc, optimizedImageSrcSet } from '../../lib/optimizedImage';
import { ensureProviderApplicationSchema, ensureProviderDetailsSchema } from '../../lib/provider-applications';

const { categoriaSlug, proveedorSlug } = Astro.params;
await ensureProviderDetailsSchema();
await ensureProviderApplicationSchema();

let p = null;
let vecinos = [];
const relatedPageSize = 6;
const requestedPage = Number(Astro.url.searchParams.get('relacionados') ?? '1');
let relatedPage = 1;
let relatedPages = 1;

try {
  const { rows } = await sql`
    SELECT p.*, c.icono as categoria_emoji, c.nombre as categoria_nombre
    FROM proveedores p
    LEFT JOIN categorias c ON p.categoria_slug = c.slug
    WHERE p.slug = ${proveedorSlug} AND p.activo = true LIMIT 1
  `;
  p = rows[0];

  if (p && p.municipio) {
    const { rows: totals } = await sql`
      SELECT COUNT(*) AS total FROM proveedores
      WHERE categoria_slug = ${categoriaSlug} AND municipio = ${p.municipio}
      AND departamento IS NOT DISTINCT FROM ${p.departamento ?? null}
      AND id != ${p.id} AND activo = true
    `;
    relatedPages = Math.max(1, Math.ceil(Number(totals[0].total) / relatedPageSize));
    if (Number.isSafeInteger(requestedPage)) {
      relatedPage = Math.max(1, Math.min(requestedPage, relatedPages));
    }
    const offset = (relatedPage - 1) * relatedPageSize;
    const { rows: vRows } = await sql`
      SELECT nombre, slug, imagen_url FROM proveedores 
      WHERE categoria_slug = ${categoriaSlug} AND municipio = ${p.municipio} 
      AND departamento IS NOT DISTINCT FROM ${p.departamento ?? null}
      AND id != ${p.id} AND activo = true
      ORDER BY nombre ASC, id ASC LIMIT ${relatedPageSize} OFFSET ${offset}
    `;
    vecinos = vRows || [];
  }
} catch (e) { console.error(e); }

if (!p) return Astro.rewrite('/404');
if (p.categoria_slug !== categoriaSlug) return Astro.redirect(`/${p.categoria_slug}/${p.slug}`, 301);

const plan = await getProviderPlan(Number(p.id));
let inquiryError = '';
if (Astro.request.method === 'POST') {
  if (plan.direct || !isSameOriginRequest(Astro.request, Astro.url)) return new Response(null, { status: 403 });
  const fields = await Astro.request.formData().catch(() => null);
  const name = String(fields?.get('name') || '').trim();
  const email = String(fields?.get('email') || '').trim().toLowerCase();
  const message = String(fields?.get('message') || '').trim();
  if (name.length < 2 || name.length > 100 || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || message.length < 10 || message.length > 1500) {
    inquiryError = 'Completa tu nombre, correo y una consulta de 10 a 1500 caracteres.';
  } else if (!fields?.get('website')) {
    await sql`
      INSERT INTO provider_inquiries (provider_id, sender_name, sender_email, message)
      SELECT ${p.id}, ${name}, ${email}, ${message}
      WHERE NOT EXISTS (
        SELECT 1 FROM provider_inquiries WHERE provider_id = ${p.id} AND sender_email = ${email}
        AND created_at > NOW() - INTERVAL '1 minute'
      )
    `;
    return Astro.redirect(Astro.url.pathname + '?consulta=enviada#consulta', 303);
  }
}

const relatedPageHref = (page: number) => `${Astro.url.pathname}${page > 1 ? `?relacionados=${page}` : ''}#proveedores-relacionados`;

const siteBase = 'https://fiestasguatemala.com';
const canonicalURL = `${siteBase}/${categoriaSlug}/${proveedorSlug}`;

const filenameWithExt = p.imagen_url ? p.imagen_url.split('/').pop() : null;
const proxyImageUrl = filenameWithExt ? `${siteBase}/api/image/${filenameWithExt}` : `${siteBase}/placeholder.jpg`;

const ubicacion = [...new Set([p.municipio, p.departamento].filter(Boolean))].join(', ');
const zona = p.municipio || p.departamento;
const tituloSEO = zona && !p.nombre.toLowerCase().includes(zona.toLowerCase()) ? `${p.nombre} en ${zona}` : p.nombre;
const metaSource = [p.nombre + ':', p.descripcion, p.eventos_atendidos, p.servicios_incluidos, p.categoria_nombre + ' en ' + ubicacion].filter(Boolean).join(' ').replace(/\s+/g, ' ').trim();
const metaDesc = (metaSource || `Consulta disponibilidad y solicita una cotización a ${tituloSEO}.`).slice(0, 155).replace(/\s+\S*$/, '').trim();
const textoWA = encodeURIComponent(`Hola ${p.nombre}, vi tu perfil en FiestasGuatemala.com y me interesa cotizar para un evento.`);
const partesDestino = [p.direccion || p.nombre, p.municipio, p.departamento, 'Guatemala'].filter(Boolean);
const destinoRuta = partesDestino.filter((parte, index) =>
  partesDestino.findIndex((candidato) => candidato.toLowerCase() === parte.toLowerCase()) === index
  && (index === 0 || !partesDestino[0].toLowerCase().includes(parte.toLowerCase()))
).join(', ');


const schemaMarkup = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${canonicalURL}#proveedor`,
    "url": canonicalURL,
    "name": p.nombre,
    "description": [p.descripcion, p.eventos_atendidos, p.servicios_incluidos, p.instalaciones].filter(Boolean).join(' ').slice(0, 1000),
    "image": proxyImageUrl,
    "telephone": plan.direct ? p.telefono || undefined : undefined,
    "email": p.email || undefined,
    "sameAs": [p.instagram_url, p.tiktok_url].filter(Boolean),
    "address": { "@type": "PostalAddress", "streetAddress": p.direccion || undefined, "addressLocality": p.municipio || undefined, "addressRegion": p.departamento || undefined, "addressCountry": "GT" },
    "areaServed": [p.municipio, p.departamento].filter(Boolean),
    "additionalProperty": [
      p.eventos_atendidos && { "@type": "PropertyValue", "name": "Eventos que atiende", "value": p.eventos_atendidos },
      p.capacidad_eventos && { "@type": "PropertyValue", "name": "Capacidad", "value": p.capacidad_eventos },
      p.servicios_incluidos && { "@type": "PropertyValue", "name": "Servicios", "value": p.servicios_incluidos },
      p.instalaciones && { "@type": "PropertyValue", "name": "Instalaciones", "value": p.instalaciones }
    ].filter(Boolean)
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{ "@type": "Question", "name": `¿Cómo contactar a ${p.nombre}?`, "acceptedAnswer": { "@type": "Answer", "text": `Puedes contactar a ${p.nombre} desde los canales disponibles en esta ficha para solicitar una cotización.` } }] },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteBase }, { "@type": "ListItem", "position": 2, "name": p.categoria_nombre, "item": `${siteBase}/${categoriaSlug}` }, { "@type": "ListItem", "position": 3, "name": p.nombre, "item": canonicalURL }] }
];
---

<Layout title={tituloSEO} description={metaDesc} ogImage={proxyImageUrl} ogImageAlt={p.nombre}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} slot="head" />
  

  <div class="bg-[#F8F7F4] min-h-screen font-sans text-[#243447]">
    <Header />
    
    <main class="max-w-5xl mx-auto pt-4 md:pt-6 pb-10 md:pb-20 px-4">
      
      <header class="mb-4 text-center md:mb-6">
        <h1 class="text-2xl md:text-4xl font-sans font-bold text-[#243447] tracking-tight leading-tight">
          {p.nombre}
        </h1>
        {ubicacion && <p class="mt-1 text-sm font-medium text-gray-600">{ubicacion}</p>}
        <nav aria-label="Ruta de navegación" class="mt-2 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-[10px] leading-relaxed uppercase tracking-wide text-[#705930] font-bold">
          <a href="/" class="hover:text-[#243447]">Inicio</a> <span>/</span> 
          <a href={`/${categoriaSlug}`}>{p.categoria_nombre}</a> <span>/</span> 
          <span class="text-[#243447] font-bold">{p.nombre}</span>
        </nav>
      </header>

      <div class="bg-white rounded-[40px] md:rounded-[50px] shadow-[0_20px_60px_-15px_rgba(0,0,0,0.1)] overflow-hidden border border-white">
        <div class="grid grid-cols-1 md:grid-cols-12">
          
          <div class="md:col-span-5 relative aspect-square md:aspect-auto bg-gray-50">
            <img 
              src={optimizedImageSrc(p.imagen_url, 800)}
              srcset={optimizedImageSrcSet(p.imagen_url)}
              sizes="(max-width: 767px) calc(100vw - 2rem), (max-width: 1023px) 42vw, 27rem"
              class="foto-proveedor w-full h-full object-cover"
              alt={p.nombre}
              width="800"
              height="800"
              fetchpriority="high"
              loading="eager"
              decoding="async"
            />
            {p.verificado && (
              <div class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-white/95 backdrop-blur-sm px-3 py-1.5 rounded-full shadow-md text-[8px] font-black uppercase tracking-widest text-[#243447]">
                <span aria-hidden="true" class="text-emerald-600">✓</span> Proveedor verificado
              </div>
            )}
          </div>

          <div class="md:col-span-7 p-6 md:p-10 flex flex-col justify-center space-y-6">
            <div class="space-y-2">
              <p class="text-[9px] font-black uppercase tracking-[0.2em] text-[#705930]">
                📍 {p.municipio}, {p.departamento}
              </p>
              {p.direccion && <p class="text-sm text-gray-500">Dirección: {p.direccion}</p>}
              <p class="text-lg md:text-xl font-sans font-medium text-[#243447] leading-snug">
                {p.descripcion}
              </p>
            </div>

            {(p.eventos_atendidos || p.capacidad_eventos || p.servicios_incluidos || p.instalaciones) && (
              <section aria-labelledby="detalles-proveedor" class="rounded-2xl border border-gray-100 bg-gray-50 p-5">
                <h2 id="detalles-proveedor" class="text-base font-bold text-[#243447]">Más información de {p.nombre}</h2>
                <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                  {p.eventos_atendidos && <div><dt class="text-xs font-bold uppercase tracking-wide text-gray-500">Eventos que atiende</dt><dd class="mt-1 whitespace-pre-line text-sm leading-relaxed text-gray-700">{p.eventos_atendidos}</dd></div>}
                  {p.capacidad_eventos && <div><dt class="text-xs font-bold uppercase tracking-wide text-gray-500">Capacidad</dt><dd class="mt-1 whitespace-pre-line text-sm leading-relaxed text-gray-700">{p.capacidad_eventos}</dd></div>}
                  {p.servicios_incluidos && <div><dt class="text-xs font-bold uppercase tracking-wide text-gray-500">Servicios</dt><dd class="mt-1 whitespace-pre-line text-sm leading-relaxed text-gray-700">{p.servicios_incluidos}</dd></div>}
                  {p.instalaciones && <div><dt class="text-xs font-bold uppercase tracking-wide text-gray-500">Instalaciones y comodidades</dt><dd class="mt-1 whitespace-pre-line text-sm leading-relaxed text-gray-700">{p.instalaciones}</dd></div>}
                </dl>
              </section>
            )}
            </div>
            
            {plan.direct ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
              <a id="btn-wa" href={`https://wa.me/502${p.whatsapp || p.telefono}?text=${textoWA}`} data-provider-action="whatsapp" data-provider-id={p.id} class="bg-[#12833c] text-white py-4 rounded-xl text-center font-black text-[10px] uppercase tracking-widest shadow-lg hover:translate-y-[-1px] transition-all">
                Escribir por WhatsApp
              </a>
              <a id="btn-call" href={`tel:+502${p.telefono}`} data-provider-action="call" data-provider-id={p.id} class="bg-[#243447] text-white py-4 rounded-xl text-center font-black text-[10px] uppercase tracking-widest transition-all">
                Llamar Ahora
              </a>
            </div>
            ) : (
              <form id="consulta" method="POST" action={Astro.url.pathname + '#consulta'} class="grid gap-3">
                <h2 class="text-lg font-bold">Enviar consulta</h2>
                {Astro.url.searchParams.get('consulta') === 'enviada' && <p role="status">Tu consulta quedó registrada.</p>}
                {inquiryError && <p role="alert" class="text-red-700">{inquiryError}</p>}
                <label class="grid gap-1 text-sm">Nombre<input name="name" required minlength="2" maxlength="100" class="rounded-lg border p-2" /></label>
                <label class="grid gap-1 text-sm">Correo para responderte<input name="email" type="email" required maxlength="254" class="rounded-lg border p-2" /></label>
                <label class="grid gap-1 text-sm">Consulta<textarea name="message" required minlength="10" maxlength="1500" class="rounded-lg border p-2"></textarea></label>
                <input name="website" tabindex="-1" autocomplete="off" hidden />
                <button class="rounded-xl bg-[#243447] px-4 py-3 font-bold text-white">Enviar consulta</button>
              </form>
            )}
            <div class="grid grid-cols-1 gap-3" aria-label="Indicaciones para llegar">
              <a href={`https://waze.com/ul?q=${encodeURIComponent(destinoRuta)}&navigate=yes`} target="_blank" rel="noopener noreferrer" data-provider-action="waze" data-provider-id={p.id} class="rounded-xl border border-[#243447]/20 bg-white px-4 py-3 text-center text-xs font-bold text-[#243447] hover:bg-[#f5f4f1]">
                Llegar con Waze
              </a>
            </div>
            <nav aria-label="Redes sociales y favoritos" class="flex w-full items-stretch gap-2 border-t border-gray-100 pt-4">
              {p.instagram_url && <a href={p.instagram_url} target="_blank" rel="noopener noreferrer" aria-label={`Instagram de ${p.nombre}`} data-provider-action="instagram" data-provider-id={p.id} class="flex min-h-10 min-w-0 flex-1 items-center justify-center gap-1 rounded-xl border border-gray-200 bg-gray-50 px-2 py-2 text-center text-xs font-semibold text-gray-600 hover:bg-gray-100"><span aria-hidden="true">◎</span><span class="truncate">Instagram</span></a>}
              {p.tiktok_url && <a href={p.tiktok_url} target="_blank" rel="noopener noreferrer" aria-label={`TikTok de ${p.nombre}`} data-provider-action="tiktok" data-provider-id={p.id} class="flex min-h-10 min-w-0 flex-1 items-center justify-center gap-1 rounded-xl border border-gray-200 bg-gray-50 px-2 py-2 text-center text-xs font-semibold text-gray-600 hover:bg-gray-100"><span aria-hidden="true">♪</span><span class="truncate">TikTok</span></a>}
              <a href={`/cuenta?guardar=${p.id}`} class="flex min-h-10 min-w-0 flex-1 items-center justify-center gap-1 rounded-xl border border-[#243447]/20 bg-white px-2 py-3 text-center text-xs font-bold text-[#243447] hover:bg-[#f5f4f1]">
                <span aria-hidden="true" class="text-lg leading-none">♡</span><span class="truncate">Guardar favorito</span>
              </a>
            </nav>


          </div>
        </div>
      </div>

      {vecinos.length > 0 && (
        <section id="proveedores-relacionados" aria-labelledby="titulo-relacionados" class="mt-10 md:mt-16 scroll-mt-24">
          <h2 id="titulo-relacionados" class="text-center text-xl font-sans font-bold text-[#243447] mb-5 border-b border-gray-100 pb-4">Más {p.categoria_nombre} en {p.municipio}</h2>
          <div class="grid grid-cols-1 min-[360px]:grid-cols-2 md:grid-cols-3 gap-3 md:gap-8">
            {vecinos.map(v => (
              <a href={`/${categoriaSlug}/${v.slug}`} class="group min-w-0">
                <div class="h-full bg-white p-2 rounded-[30px] shadow-sm border border-white transition-all group-hover:shadow-md">
                  <div class="aspect-square rounded-[22px] overflow-hidden mb-3 bg-gray-50">
                    <img
                      src={optimizedImageSrc(v.imagen_url, 400)}
                      srcset={optimizedImageSrcSet(v.imagen_url)}
                      sizes="(max-width: 359px) calc(100vw - 3rem), (max-width: 767px) calc(50vw - 1.875rem), (max-width: 1023px) 30vw, 20rem"
                      class="foto-proveedor w-full h-full object-cover group-hover:scale-105 transition-transform"
                      alt=""
                      width="400"
                      height="400"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <h3 class="font-sans font-bold text-sm leading-snug text-[#243447] px-1 text-center [overflow-wrap:anywhere]">{v.nombre}</h3>
                </div>
              </a>
            ))}
          </div>
          {relatedPages > 1 && (
            <nav aria-label="Páginas de proveedores relacionados" class="mt-5 flex flex-wrap items-center justify-center gap-3 text-sm">
              {relatedPage > 1 && (
                <a href={relatedPageHref(relatedPage - 1)} class="inline-flex min-h-11 items-center rounded-xl border border-gray-300 bg-white px-3 font-semibold">Anterior</a>
              )}
              <span>Página {relatedPage} de {relatedPages}</span>
              {relatedPage < relatedPages && (
                <a href={relatedPageHref(relatedPage + 1)} class="inline-flex min-h-11 items-center rounded-xl bg-[#243447] px-3 font-semibold text-white">Siguiente</a>
              )}
            </nav>
          )}
        </section>
      )}
    </main>
    <Footer />
  </div>

  <style>
    .foto-proveedor {
      aspect-ratio: 1 / 1;
      width: 100%;
      height: auto;
      content-visibility: auto;
      display: block;
    }
    
    @media (min-width: 768px) {
      .md\:aspect-auto .foto-proveedor {
        aspect-ratio: auto;
        min-height: 400px;
      }
    }
  </style>

</Layout>
<script define:vars={{ providerId: Number(p.id) }}>
  if (!document.cookie.split('; ').some((cookie) => cookie.startsWith('fg_visitor='))) {
    document.cookie = 'fg_visitor=' + crypto.randomUUID() + '; Path=/; Max-Age=31536000; SameSite=Lax; Secure';
  }
  function track(action) {
    const blob = new Blob([JSON.stringify({ providerId, action })], { type: 'application/json' });
    if (!navigator.sendBeacon?.('/api/provider-click', blob)) {
      fetch('/api/provider-click', { method: 'POST', body: blob, keepalive: true }).catch(() => {});
    }
  }
  track('view');
  document.querySelectorAll('[data-provider-action]').forEach((element) => {
    element.addEventListener('click', () => track(element.dataset.providerAction));
  });
</script>
