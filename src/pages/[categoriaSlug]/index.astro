---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { sql } from '@vercel/postgres';
import { optimizedImageSrc, optimizedImageSrcSet } from '../../lib/optimizedImage';
import { ensureProviderApplicationSchema } from '../../lib/provider-applications';
import { departamentos } from '../../lib/departamentos';

const { categoriaSlug } = Astro.params;
await ensureProviderApplicationSchema();
const { rows: categoryRows } = await sql`SELECT slug, nombre, descripcion FROM categorias WHERE slug = ${categoriaSlug} LIMIT 1`;
const category = categoryRows[0];
if (!category) {
  const { rows: redirects } = await sql`SELECT new_slug FROM category_slug_redirects WHERE old_slug = ${categoriaSlug} LIMIT 1`;
  if (redirects[0]) return Astro.redirect('/' + redirects[0].new_slug, 301);
  Astro.response.status = 404;
}

// 1. UTILIDADES
const capitalize = (str) => str ? str.replace(/\b\w/g, l => l.toUpperCase()) : "";
const nombreLimpio = category?.nombre || (categoriaSlug ? categoriaSlug.replace(/-/g, ' ') : '');
const nombreCapitalizado = capitalize(nombreLimpio);
const fecha = new Date();
const fechaActualizacion = `${["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"][fecha.getMonth()]} ${fecha.getFullYear()}`;

// 2. DATOS DE DB
let proveedores = [];
let todasLasCategorias = [];
try {
  const resProv = await sql`SELECT * FROM proveedores WHERE categoria_slug ILIKE ${categoriaSlug} AND activo = true ORDER BY es_premium DESC, nombre ASC`;
  proveedores = resProv.rows || [];
  const resTodas = await sql`SELECT nombre, slug FROM categorias ORDER BY nombre ASC`;
  todasLasCategorias = resTodas.rows || [];
} catch (e) { console.error(e); }

// DATOS PARA FILTROS LOCALES
const normalizarTexto = (value) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es').trim();
const ubicacionesPopulares = [...new Map(
  proveedores
    .filter(p => p.departamento && p.municipio)
    .map(p => [`${normalizarTexto(p.departamento)}|${normalizarTexto(p.municipio)}`, { departamento: p.departamento, municipio: p.municipio }])
).values()].slice(0, 6);

const siteBase = 'https://fiestasguatemala.com';
const titleSEO = nombreCapitalizado + ' en Guatemala | Proveedores para eventos';
const descriptionSEO = category?.descripcion?.trim() || ('Explora ' + proveedores.length + ' proveedores activos de ' + nombreLimpio + ' en Guatemala. Consulta perfiles, zonas de servicio y opciones para cotizar.');
const schemaMarkup = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: titleSEO,
  description: descriptionSEO,
  url: siteBase + '/' + categoriaSlug,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: proveedores.length,
    itemListElement: proveedores.map((proveedor, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: proveedor.nombre,
      url: siteBase + '/' + categoriaSlug + '/' + proveedor.slug
    }))
  }
};
---

<Layout title={titleSEO} description={descriptionSEO}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} slot="head" />

  <div class="bg-[#f0efec] min-h-screen font-sans text-[#243447]">
    <Header />
    <main class="max-w-6xl mx-auto px-6 pt-10 pb-20">
      
      <header class="mb-12">
        <nav class="mb-7 text-[10px] uppercase tracking-[0.2em] text-[#5b4827] font-bold" aria-label="Ruta de navegación">
          <a href="/" class="no-underline hover:text-[#243447]">Inicio</a>
          <span class="mx-2 text-[#8b7355]/50">/</span>
          <span class="text-[#705930] font-black">{nombreCapitalizado}</span>
        </nav>

        <h1 class="text-4xl md:text-6xl font-serif font-light text-[#243447] mb-4 leading-tight">
          {nombreCapitalizado} <span class="text-[#705930]">en Guatemala</span>
        </h1>
        {category?.descripcion && <p class="max-w-3xl text-base leading-7 text-gray-600 mb-6">{category.descripcion}</p>}
        <div class="flex items-center gap-2 text-[10px] uppercase tracking-widest text-[#4b5563] font-bold mb-7">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          Actualizado: {fechaActualizacion}
        </div>
        <section class="rounded-2xl border border-[#8b7355]/15 bg-white p-5 shadow-sm md:p-6" aria-label="Filtros de ubicación">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
            <div class="flex items-start gap-3 lg:max-w-sm">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#f4f1eb] text-lg" aria-hidden="true">📍</span>
              <div>
                <h2 class="text-sm font-bold text-[#243447]">Filtrar por ubicación</h2>
                <p class="mt-1 text-sm leading-5 text-gray-500">Selecciona un departamento y, si quieres, afina por municipio.</p>
              </div>
            </div>
            <div class="grid w-full grid-cols-1 gap-3 sm:grid-cols-2 lg:max-w-2xl">
              <label class="flex flex-col gap-1.5 text-xs font-semibold text-[#5b4827]">
                Departamento
                <select id="departmentFilter" class="h-12 w-full rounded-xl border border-[#243447]/15 bg-[#faf9f7] px-4 text-sm font-normal text-[#243447] shadow-sm transition focus:border-[#a68a56] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#a68a56]/20">
                  <option value="">Todos los departamentos</option>
                  {departamentos.map(({ nombre }) => <option value={nombre}>{nombre}</option>)}
                </select>
              </label>
              <label class="flex flex-col gap-1.5 text-xs font-semibold text-[#5b4827]">
                Municipio
                <select id="municipalityFilter" disabled class="h-12 w-full rounded-xl border border-[#243447]/15 bg-[#faf9f7] px-4 text-sm font-normal text-[#243447] shadow-sm transition focus:border-[#a68a56] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#a68a56]/20 disabled:cursor-not-allowed disabled:text-gray-400">
                  <option value="">Elige primero un departamento</option>
                </select>
              </label>
            </div>
          </div>
        </section>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 mb-24" id="gridProveedores">
        {proveedores.map((p, index) => {
          const urlPerfil = `/${categoriaSlug}/${p.slug}`;
          
          // 🔥 LÓGICA DE IMAGEN REAL DESDE DB + PROXY
          const fotoFinal = optimizedImageSrc(p.imagen_url, 800);
          const fotoSrcSet = optimizedImageSrcSet(p.imagen_url);

          return (
            <div class="card-proveedor bg-white rounded-[35px] overflow-hidden border border-gray-100 shadow-sm flex flex-col group" data-department={p.departamento || ''} data-municipality={p.municipio || ''}>
              <a href={urlPerfil} class="relative block h-64 overflow-hidden">
                <img 
                  src={fotoFinal}
                  srcset={fotoSrcSet}
                  sizes="(max-width: 767px) calc(100vw - 3rem), (max-width: 1023px) calc(50vw - 2rem), 25rem"
                  alt={p.nombre}
                  width="800"
                  height="600"
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={index === 0 ? "high" : "auto"}
                />
                {p.verificado && (
                  <div class="absolute bottom-4 right-4 bg-white/95 px-3 py-1.5 rounded-full flex items-center gap-1 shadow-sm border border-gray-100">
                    <span class="text-[#705930] text-[10px]">★</span>
                    <span class="text-[8px] font-black uppercase tracking-widest text-[#243447]">Verificado</span>
                  </div>
                )}
              </a>
              <div class="p-7 flex flex-col flex-1">
                <a href={urlPerfil} class="no-underline"><h2 class="font-serif text-xl text-[#243447] mb-2">{p.nombre}</h2></a>
                <div class="text-[#5b4827] text-[10px] font-bold uppercase mb-4 tracking-wider">📍 {p.municipio || p.departamento}</div>
                <p class="text-gray-600 text-[13px] font-light line-clamp-3 italic mb-8">"{p.descripcion || `Especialistas en ${nombreLimpio} en Guatemala.`}"</p>
                <div class="flex justify-end border-t border-gray-50 pt-6 mt-auto">
                   <a href={urlPerfil} class="bg-[#243447] text-white px-6 py-2.5 rounded-full text-[10px] uppercase font-bold no-underline">Ver Perfil</a>
                </div>
              </div>
            </div>
          )
        })}
      </div>

      {ubicacionesPopulares.length > 0 && (
        <section class="mb-20">
          <h3 class="text-xs uppercase tracking-[0.3em] text-[#5b4827] font-black mb-6 text-center">Búsquedas Populares de {nombreCapitalizado}</h3>
          <div class="flex flex-wrap justify-center gap-3">
            {ubicacionesPopulares.map(({ departamento, municipio }) => (
              <button type="button" data-popular-department={departamento} data-popular-municipality={municipio} class="popular-location px-5 py-2.5 rounded-full bg-white border border-[#8b7355]/20 text-[10px] font-bold text-[#5b4827] hover:bg-[#243447] hover:text-white transition-all uppercase tracking-widest cursor-pointer">
                {nombreCapitalizado} en {municipio}
              </button>
            ))}
          </div>
        </section>
      )}

      <section class="mt-20 p-10 bg-[#243447] rounded-[40px] text-white relative shadow-2xl overflow-hidden">
        <h2 class="text-2xl font-serif mb-10 text-center">Directorio Nacional</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-y-4 gap-x-12 relative z-10">
          {todasLasCategorias.map(cat => (
            <a href={`/${cat.slug}`} class="text-white/70 hover:text-[#705930] transition-colors text-sm flex items-center gap-3 no-underline group">
              <span class="text-[#705930] text-[8px] group-hover:scale-125 transition-transform">◆</span>
              <span class="border-b border-transparent group-hover:border-[#a68a56]">{cat.nombre}</span>
            </a>
          ))}
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>

<script>
  function setupSearch() {
    const departmentSelect = document.getElementById('departmentFilter') as HTMLSelectElement | null;
    const municipalitySelect = document.getElementById('municipalityFilter') as HTMLSelectElement | null;
    const cards = [...document.querySelectorAll<HTMLElement>('.card-proveedor')];
    const popularButtons = [...document.querySelectorAll<HTMLButtonElement>('.popular-location')];
    if (!departmentSelect || !municipalitySelect) return;

    const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es').trim();

    const updateMunicipalities = () => {
      const selectedDepartment = departmentSelect.value;
      municipalitySelect.replaceChildren();

      const defaultOption = document.createElement('option');
      defaultOption.value = '';
      defaultOption.textContent = selectedDepartment ? 'Todos los municipios' : 'Elige primero un departamento';
      municipalitySelect.append(defaultOption);
      municipalitySelect.disabled = !selectedDepartment;

      if (selectedDepartment) {
        const municipalities = new Map<string, string>();
        cards.forEach(card => {
          if (normalize(card.dataset.department || '') !== normalize(selectedDepartment)) return;
          const municipality = card.dataset.municipality?.trim();
          if (municipality) municipalities.set(normalize(municipality), municipality);
        });

        [...municipalities.values()].sort((a, b) => a.localeCompare(b, 'es')).forEach(municipality => {
          const option = document.createElement('option');
          option.value = municipality;
          option.textContent = municipality;
          municipalitySelect.append(option);
        });
      }
    };

    const applyFilters = () => {
      const selectedDepartment = normalize(departmentSelect.value);
      const selectedMunicipality = normalize(municipalitySelect.value);
      cards.forEach(card => {
        const matchesDepartment = !selectedDepartment || normalize(card.dataset.department || '') === selectedDepartment;
        const matchesMunicipality = !selectedMunicipality || normalize(card.dataset.municipality || '') === selectedMunicipality;
        card.style.display = matchesDepartment && matchesMunicipality ? 'flex' : 'none';
      });
    };

    departmentSelect.onchange = () => {
      updateMunicipalities();
      applyFilters();
    };
    municipalitySelect.onchange = applyFilters;

    popularButtons.forEach(button => {
      button.onclick = () => {
        departmentSelect.value = button.dataset.popularDepartment || '';
        updateMunicipalities();
        municipalitySelect.value = button.dataset.popularMunicipality || '';
        applyFilters();
      };
    });
  }
  setupSearch();
  document.addEventListener('astro:after-swap', setupSearch);
</script>
