---
export const prerender = false;
import { sql } from '@vercel/postgres';
import Layout from '../layouts/Layout.astro';
import { isSameOriginRequest } from '../lib/admin-auth';
import {
  CUSTOMER_SESSION_COOKIE, CUSTOMER_SESSION_MAX_AGE, createCustomerSessionToken,
  ensureCustomerAccountSchema, hashCustomerPassword, normalizeCustomerEmail,
  readCustomerSessionToken, verifyCustomerPassword,
} from '../lib/customer-accounts';

await ensureCustomerAccountSchema();
const customerId = readCustomerSessionToken(Astro.cookies.get(CUSTOMER_SESSION_COOKIE)?.value);
const saveProviderId = Number(Astro.url.searchParams.get('guardar'));
let error = '';
let success = '';

if (Astro.request.method === 'POST') {
  try {
    if (!isSameOriginRequest(Astro.request, Astro.url)) throw new Error('Solicitud no permitida.');
    const data = await Astro.request.formData();
    const action = data.get('accion')?.toString() || '';
    if (action === 'registro' || action === 'login') {
      const email = normalizeCustomerEmail(data.get('email')?.toString() || '');
      const password = data.get('password')?.toString() || '';
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new Error('Ingresa un correo válido.');
      if (password.length < 10 || password.length > 128) throw new Error('Usa una contraseña de 10 a 128 caracteres.');
      let id: number;
      if (action === 'registro') {
        const name = (data.get('nombre')?.toString() || '').trim();
        if (name.length < 2 || name.length > 100) throw new Error('Ingresa tu nombre.');
        const passwordHash = await hashCustomerPassword(password);
        const { rows } = await sql`
          INSERT INTO customer_accounts (name, email, password_hash)
          VALUES (${name}, ${email}, ${passwordHash})
          RETURNING id
        `;
        id = Number(rows[0].id);
      } else {
        const { rows } = await sql`SELECT id, password_hash FROM customer_accounts WHERE email = ${email} LIMIT 1`;
        if (!rows[0] || !(await verifyCustomerPassword(password, rows[0].password_hash))) throw new Error('El correo o la contraseña no son correctos.');
        id = Number(rows[0].id);
      }
      Astro.cookies.set(CUSTOMER_SESSION_COOKIE, createCustomerSessionToken(id), {
        path: '/cuenta', httpOnly: true, secure: true, sameSite: 'lax', maxAge: CUSTOMER_SESSION_MAX_AGE,
      });
      const target = saveProviderId > 0 ? `/cuenta?guardar=${saveProviderId}` : '/cuenta';
      return Astro.redirect(target, 303);
    }
    if (action === 'salir') {
      Astro.cookies.delete(CUSTOMER_SESSION_COOKIE, { path: '/cuenta' });
      return Astro.redirect('/cuenta', 303);
    }
    if (!customerId) return Astro.redirect('/cuenta', 303);
    const providerId = Number(data.get('provider_id'));
    if (!Number.isSafeInteger(providerId) || providerId < 1) throw new Error('No se encontró el proveedor.');
    const { rows } = await sql`SELECT id FROM proveedores WHERE id = ${providerId} AND activo = TRUE LIMIT 1`;
    if (!rows[0]) throw new Error('Este proveedor ya no está disponible.');
    if (action === 'guardar') {
      await sql`INSERT INTO customer_favorites (customer_id, provider_id) VALUES (${customerId}, ${providerId}) ON CONFLICT (customer_id, provider_id) DO NOTHING`;
      success = 'Proveedor guardado en tus favoritos.';
    } else if (action === 'quitar') {
      await sql`DELETE FROM customer_favorites WHERE customer_id = ${customerId} AND provider_id = ${providerId}`;
      success = 'Proveedor eliminado de tus favoritos.';
    } else if (action === 'contactado') {
      await sql`INSERT INTO customer_provider_contacts (customer_id, provider_id) VALUES (${customerId}, ${providerId}) ON CONFLICT (customer_id, provider_id) DO UPDATE SET contacted_at = NOW()`;
      success = 'Contacto registrado en tu lista.';
    }
  } catch (cause) {
    const message = cause instanceof Error ? cause.message : '';
    error = message.includes('customer_accounts_email_key') ? 'Ya existe una cuenta con este correo. Inicia sesión.' : (message || 'No se pudo completar la solicitud.');
  }
}

let customer = null;
let favorites = [];
let contacts = [];
if (customerId) {
  const [account, saved, contacted] = await Promise.all([
    sql`SELECT id, name, email FROM customer_accounts WHERE id = ${customerId} LIMIT 1`,
    sql`SELECT p.id, p.nombre, p.slug, p.imagen_url, c.slug AS categoria_slug, c.nombre AS categoria_nombre
        FROM customer_favorites f JOIN proveedores p ON p.id = f.provider_id
        LEFT JOIN categorias c ON c.slug = p.categoria_slug
        WHERE f.customer_id = ${customerId} AND p.activo = TRUE ORDER BY f.created_at DESC`,
    sql`SELECT p.id, p.nombre, p.slug, c.slug AS categoria_slug, c.nombre AS categoria_nombre, x.contacted_at
        FROM customer_provider_contacts x JOIN proveedores p ON p.id = x.provider_id
        LEFT JOIN categorias c ON c.slug = p.categoria_slug
        WHERE x.customer_id = ${customerId} AND p.activo = TRUE ORDER BY x.contacted_at DESC`,
  ]);
  customer = account.rows[0] || null;
  favorites = saved.rows;
  contacts = contacted.rows;
  if (!customer) {
    Astro.cookies.delete(CUSTOMER_SESSION_COOKIE, { path: '/cuenta' });
    return Astro.redirect('/cuenta');
  }
  if (saveProviderId > 0) {
    const { rows } = await sql`SELECT id FROM proveedores WHERE id = ${saveProviderId} AND activo = TRUE LIMIT 1`;
    if (rows[0]) {
      await sql`INSERT INTO customer_favorites (customer_id, provider_id) VALUES (${customerId}, ${saveProviderId}) ON CONFLICT (customer_id, provider_id) DO NOTHING`;
      return Astro.redirect('/cuenta?guardado=1');
    }
  }
}
---
<Layout title="Mi cuenta | Fiestas Guatemala" description="Guarda proveedores favoritos y organiza los contactos de tu evento.">
  <main class="min-h-screen px-4 py-10 text-[#243447] sm:py-16">
    <div class="mx-auto max-w-3xl">
      <a href="/" class="text-sm font-bold text-[#705930]">← Fiestas Guatemala</a>
      {customer ? <>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <div><p class="text-xs font-black uppercase tracking-[0.18em] text-[#705930]">Tu espacio para organizar</p><h1 class="mt-2 text-3xl font-black">Hola, {customer.name}</h1></div>
          <form method="POST"><input type="hidden" name="accion" value="salir" /><button class="rounded-xl border border-gray-200 px-4 py-3 font-bold">Cerrar sesión</button></form>
        </div>
        <p class="mt-2 text-gray-600">{customer.email}</p>
        {Astro.url.searchParams.has('guardado') && <p role="status" class="mt-5 rounded-xl bg-green-50 p-4 text-green-800">Proveedor agregado a tus favoritos.</p>}
        {success && <p role="status" class="mt-5 rounded-xl bg-green-50 p-4 text-green-800">{success}</p>}
        {error && <p role="alert" class="mt-5 rounded-xl bg-red-50 p-4 text-red-800">{error}</p>}
        <section class="mt-8 rounded-3xl bg-white p-6 shadow-sm sm:p-8">
          <h2 class="text-xl font-black">Mis proveedores guardados</h2>
          {favorites.length ? <ul class="mt-4 divide-y divide-gray-100">
            {favorites.map((provider) => <li class="flex flex-wrap items-center justify-between gap-3 py-4">
              <a class="font-bold text-[#243447] underline" href={`/${provider.categoria_slug}/${provider.slug}`}>{provider.nombre}</a>
              <div class="flex gap-2">
                <form method="POST"><input type="hidden" name="accion" value="contactado" /><input type="hidden" name="provider_id" value={provider.id} /><button class="rounded-lg bg-[#187b45] px-3 py-2 text-sm font-bold text-white">Ya lo contacté</button></form>
                <form method="POST"><input type="hidden" name="accion" value="quitar" /><input type="hidden" name="provider_id" value={provider.id} /><button class="rounded-lg border px-3 py-2 text-sm">Quitar</button></form>
              </div>
            </li>)}
          </ul> : <p class="mt-3 text-gray-600">Cuando encuentres un proveedor, toca “Guardar favorito” en su perfil y aparecerá aquí.</p>}
        </section>
        <section class="mt-6 rounded-3xl bg-white p-6 shadow-sm sm:p-8">
          <h2 class="text-xl font-black">Contactos de mi evento</h2>
          {contacts.length ? <ul class="mt-4 space-y-3">{contacts.map((provider) => <li><a class="font-bold underline" href={`/${provider.categoria_slug}/${provider.slug}`}>{provider.nombre}</a><span class="ml-2 text-sm text-gray-500">Contactado {new Date(provider.contacted_at).toLocaleDateString('es-GT')}</span></li>)}</ul> : <p class="mt-3 text-gray-600">Marca “Ya lo contacté” para llevar tu seguimiento.</p>}
        </section>
      </> : <section class="mt-6 rounded-3xl bg-white p-6 shadow-sm sm:p-9">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-[#705930]">Gratis para organizar tu evento</p>
        <h1 class="mt-2 text-3xl font-black">Guarda tus opciones y vuelve cuando quieras</h1>
        <p class="mt-3 text-gray-600">Crea una lista de proveedores favoritos y lleva el seguimiento de a quién ya contactaste.</p>
        {error && <p role="alert" class="mt-5 rounded-xl bg-red-50 p-4 text-red-800">{error}</p>}
        <div class="mt-7 grid gap-6 md:grid-cols-2">
          <form method="POST" class="space-y-4 rounded-2xl border border-gray-100 p-5">
            <h2 class="text-xl font-black">Crear cuenta</h2>
            <input type="hidden" name="accion" value="registro" />
            <label class="block text-sm font-bold">Tu nombre<input name="nombre" autocomplete="name" required minlength="2" maxlength="100" class="mt-1 w-full rounded-xl border px-4 py-3" /></label>
            <label class="block text-sm font-bold">Correo electrónico<input type="email" name="email" autocomplete="email" required maxlength="180" class="mt-1 w-full rounded-xl border px-4 py-3" /></label>
            <label class="block text-sm font-bold">Contraseña<input type="password" name="password" autocomplete="new-password" required minlength="10" maxlength="128" class="mt-1 w-full rounded-xl border px-4 py-3" /><span class="mt-1 block font-normal text-gray-500">Mínimo 10 caracteres</span></label>
            <button class="w-full rounded-xl bg-[#243447] px-5 py-3 font-bold text-white">Crear cuenta gratis</button>
          </form>
          <form method="POST" class="space-y-4 rounded-2xl border border-gray-100 p-5">
            <h2 class="text-xl font-black">Ya tengo cuenta</h2>
            <input type="hidden" name="accion" value="login" />
            <label class="block text-sm font-bold">Correo electrónico<input type="email" name="email" autocomplete="email" required maxlength="180" class="mt-1 w-full rounded-xl border px-4 py-3" /></label>
            <label class="block text-sm font-bold">Contraseña<input type="password" name="password" autocomplete="current-password" required maxlength="128" class="mt-1 w-full rounded-xl border px-4 py-3" /></label>
            <button class="w-full rounded-xl border border-[#243447] px-5 py-3 font-bold text-[#243447]">Iniciar sesión</button>
          </form>
        </div>
      </section>}
    </div>
  </main>
</Layout>
