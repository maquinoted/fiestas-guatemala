
---
export const prerender = false;
import { sql } from '@vercel/postgres';
import Layout from '../../layouts/Layout.astro';
import { isSameOriginRequest } from '../../lib/admin-auth';
import { ensureProviderApplicationSchema, normalizeEmail, normalizeGuatemalaPhone, normalizeSlug, PROVIDER_SESSION_COOKIE, readProviderSessionToken, uploadProviderImage } from '../../lib/provider-applications';

await ensureProviderApplicationSchema();
const applicationId = readProviderSessionToken(Astro.cookies.get(PROVIDER_SESSION_COOKIE)?.value);
if (!applicationId) return Astro.redirect('/proveedores/login');
let { rows: applicationRows } = await sql`SELECT * FROM provider_applications WHERE id = ${applicationId} LIMIT 1`;
let application = applicationRows[0];
if (!application) {
  Astro.cookies.delete(PROVIDER_SESSION_COOKIE, { path: '/proveedores' });
  return Astro.redirect('/proveedores/login');
}
let message = '';
let error = '';
let profile = null;

if (application.status === 'approved' && application.provider_id) {
  const { rows } = await sql`SELECT * FROM proveedores WHERE id = ${application.provider_id} LIMIT 1`;
  profile = rows[0] || null;
}
if (Astro.request.method === 'POST') {
  try {
    if (!isSameOriginRequest(Astro.request, Astro.url)) throw new Error('Solicitud no permitida.');
    if (application.status === 'processing') throw new Error('La solicitud está en proceso de aprobación. Inténtalo más tarde.');
    const data = await Astro.request.formData();
    if (data.get('action') !== 'save-profile') throw new Error('La solicitud no es válida.');

    const name = (data.get('company_name')?.toString() || '').trim().slice(0, 140);
    const description = (data.get('description')?.toString() || '').trim().slice(0, 1800);
    const phone = (data.get('phone')?.toString() || '').trim();
    const whatsapp = (data.get('whatsapp')?.toString() || '').trim();
    const department = (data.get('department')?.toString() || '').trim().slice(0, 100);
    const municipality = (data.get('municipality')?.toString() || '').trim().slice(0, 100);
    const priceFrom = Number(data.get('price_from') || 0);
    const instagram = (data.get('instagram_url')?.toString() || '').trim().slice(0, 300);
    const tiktok = (data.get('tiktok_url')?.toString() || '').trim().slice(0, 300);
    const address = (data.get('address')?.toString() || '').trim().slice(0, 300);
    const photo = data.get('photo');
    const validSocial = (value: string, domain: string) => {
      if (!value) return true;
      try { const url = new URL(value); return url.protocol === 'https:' && (url.hostname === domain || url.hostname.endsWith('.' + domain)); }
      catch { return false; }
    };
    if (name.length < 2 || description.length < 20 || !/^\d{8}$/.test(phone) || !/^\d{8}$/.test(whatsapp)) throw new Error('Completa nombre y descripción, e ingresa teléfono y WhatsApp con 8 dígitos sin espacios ni letras.');
    if (priceFrom !== 0 && (!Number.isSafeInteger(priceFrom) || priceFrom < 1 || priceFrom > 1000000)) throw new Error('Escribe un precio mínimo válido o deja el campo vacío.');
    if (!validSocial(instagram, 'instagram.com') || !validSocial(tiktok, 'tiktok.com')) throw new Error('Revisa los enlaces de Instagram y TikTok.');
    const [{ rows: departmentRows }, { rows: municipalityRows }] = await Promise.all([
      sql`SELECT nombre FROM departamentos WHERE nombre = ${department} LIMIT 1`,
      sql`SELECT m.nombre FROM municipios m INNER JOIN departamentos d ON d.id = m.departamento_id WHERE m.nombre = ${municipality} AND d.nombre = ${department} LIMIT 1`,
    ]);
    if (!departmentRows[0] || !municipalityRows[0]) throw new Error('Selecciona un departamento y municipio válidos.');

    const oldImageUrl = profile?.imagen_url || application.image_url || '';
    const imageUrl = photo instanceof File && photo.size > 0
      ? await uploadProviderImage(photo, name)
      : oldImageUrl;
    const nextStatus = application.status === 'rejected' ? 'pending' : application.status;
    if (application.status === 'approved' && profile) {
      await sql`
        UPDATE proveedores SET nombre = ${name}, descripcion = ${description}, telefono = ${phone},
          whatsapp = ${whatsapp}, municipio = ${municipality}, departamento = ${department},
          precio_desde = ${priceFrom}, imagen_url = ${imageUrl}, instagram_url = ${instagram},
          tiktok_url = ${tiktok}, direccion = ${address}
        WHERE id = ${application.provider_id}
      `;
    }
    await sql`
      UPDATE provider_applications SET company_name = ${name}, description = ${description},
        phone = ${phone}, whatsapp = ${whatsapp}, department = ${department}, municipality = ${municipality},
        price_from = ${priceFrom}, image_url = ${imageUrl}, instagram_url = ${instagram},
        tiktok_url = ${tiktok}, address = ${address}, status = ${nextStatus},
        admin_note = CASE WHEN status = 'rejected' THEN '' ELSE admin_note END,
        reviewed_by = CASE WHEN status = 'rejected' THEN NULL ELSE reviewed_by END,
        reviewed_at = CASE WHEN status = 'rejected' THEN NULL ELSE reviewed_at END,
        updated_at = NOW()
      WHERE id = ${applicationId}
    `;
    return Astro.redirect('/proveedores/panel?guardado=1');
  } catch (cause) {
    error = cause instanceof Error ? cause.message : 'No se pudo guardar la información.';
  }
}

const [{ rows: departments }, { rows: municipalities }, { rows: categoryRows }] = await Promise.all([
  sql`SELECT id, nombre FROM departamentos ORDER BY nombre`,
  sql`SELECT nombre, departamento_id FROM municipios ORDER BY nombre`,
  sql`SELECT nombre FROM categorias WHERE slug = ${application.category_slug} LIMIT 1`,
]);
const current = profile || application;
const statusLabels: Record<string, string> = { pending: 'Pendiente de revisión', processing: 'En aprobación', approved: 'Aprobado y publicado', rejected: 'No aprobado' };
---
<Layout title="Panel de proveedor | Fiestas Guatemala">
  <main class="min-h-screen bg-[#F8F9FA] px-4 py-8 text-[#243447] sm:px-6 md:py-12"><div class="mx-auto max-w-5xl space-y-6">
    <header class="flex flex-col justify-between gap-4 rounded-3xl bg-[#243447] p-6 text-white sm:flex-row sm:items-center md:p-8">
      <div><p class="text-xs font-black uppercase tracking-[0.2em] text-[#D9C39B]">Área de proveedores</p><h1 class="mt-2 text-3xl font-black">Hola, {application.company_name}</h1><p class="mt-2 text-sm text-white/75">{application.contact_email}</p></div>
      <a href="/proveedores/logout" class="rounded-xl border border-white/30 px-4 py-3 text-center text-sm font-bold text-white">Cerrar sesión</a>
    </header>
    <section class:list={['rounded-2xl border p-5', application.status === 'approved' ? 'border-green-200 bg-green-50' : application.status === 'rejected' ? 'border-red-200 bg-red-50' : 'border-amber-200 bg-amber-50']}>
      <p class="font-black">Estado: {statusLabels[application.status] || application.status}</p>
      {application.status === 'pending' && <p class="mt-1 text-sm">El administrador todavía está revisando tu solicitud.</p>}
      {application.status === 'processing' && <p class="mt-1 text-sm">El administrador está procesando la solicitud. Puedes volver a revisar este panel más tarde.</p>}
      {application.status === 'approved' && profile && <p class="mt-1 text-sm">Tu perfil ya aparece en el directorio. <a href={'/' + application.category_slug + '/' + profile.slug} class="font-bold underline">Ver perfil público</a></p>}
      {application.status === 'rejected' && <div class="mt-2"><p class="text-sm font-bold">Razón del administrador:</p><p class="mt-1 whitespace-pre-line text-sm">{application.admin_note || 'No se indicó una razón. Contacta al administrador para más información.'}</p><p class="mt-2 text-sm">Puedes corregir los datos y enviarlos nuevamente a revisión.</p></div>}
    </section>
    {Astro.url.searchParams.has('guardado') && <p role="status" class="rounded-xl bg-green-50 p-4 text-sm text-green-800">Tus datos se guardaron correctamente.</p>}
    {error && <p role="alert" class="rounded-xl bg-red-50 p-4 text-sm text-red-700">{error}</p>}
    {application.status !== 'processing' && <form method="POST" enctype="multipart/form-data" class="grid gap-6 rounded-3xl bg-white p-6 shadow-sm md:grid-cols-2 md:p-8">
      <input type="hidden" name="action" value="save-profile" />
      <div class="md:col-span-2"><h2 class="text-xl font-black">Información del negocio</h2><p class="mt-1 text-sm text-gray-500">El correo de acceso no se puede cambiar desde este formulario. Categoría: {categoryRows[0]?.nombre || application.category_slug}</p></div>
      <label class="block text-sm font-bold">Nombre comercial<input name="company_name" maxlength="140" required value={current.nombre || current.company_name} class="mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 placeholder:text-gray-600 placeholder:opacity-100" /></label>
      <label class="block text-sm font-bold">WhatsApp<input name="whatsapp" type="tel" inputmode="numeric" pattern="[0-9]{8}" minlength="8" maxlength="8" required value={normalizeGuatemalaPhone(current.whatsapp || '')} placeholder="8 dígitos, sin espacios" class="mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 placeholder:text-gray-600 placeholder:opacity-100" /></label>
      <label class="block text-sm font-bold md:col-span-2">Descripción<textarea name="description" minlength="20" maxlength="1800" rows="4" required class="mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 placeholder:text-gray-600 placeholder:opacity-100">{current.descripcion || current.description}</textarea></label>
      <label class="block text-sm font-bold">Teléfono de contacto<input name="phone" type="tel" inputmode="numeric" pattern="[0-9]{8}" minlength="8" maxlength="8" required value={normalizeGuatemalaPhone(current.telefono || current.phone || '')} placeholder="8 dígitos, sin espacios" class="mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 placeholder:text-gray-600 placeholder:opacity-100" /></label>
      <label class="block text-sm font-bold">Precio mínimo (Q, opcional)<input type="number" name="price_from" min="1" max="1000000" step="1" value={(current.precio_desde ?? current.price_from) || ''} placeholder="Deja vacío si prefieres cotizar" class="mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 placeholder:text-gray-600 placeholder:opacity-100" /><span class="mt-1 block text-xs font-normal text-gray-600">Si lo dejas vacío, tu perfil mostrará “Consultar precio”.</span></label>
      <label class="block text-sm font-bold">Departamento<select name="department" id="providerDepartment" required class="mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 placeholder:text-gray-600 placeholder:opacity-100"><option value="">Selecciona</option>{departments.map((department) => <option value={department.nombre} selected={department.nombre === (current.departamento || current.department)}>{department.nombre}</option>)}</select></label>
      <label class="block text-sm font-bold">Municipio<select name="municipality" id="providerMunicipality" required class="mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 placeholder:text-gray-600 placeholder:opacity-100"><option value="">Selecciona</option>{municipalities.map((municipality) => { const department = departments.find((item) => Number(item.id) === Number(municipality.departamento_id)); return <option value={municipality.nombre} data-department={department?.nombre || ''} selected={municipality.nombre === (current.municipio || current.municipality)}>{municipality.nombre} · {department?.nombre || ''}</option>; })}</select></label>
      <label class="block text-sm font-bold">Instagram (opcional)<input type="url" name="instagram_url" maxlength="300" value={current.instagram_url || ''} placeholder="https://www.instagram.com/usuario" class="mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 placeholder:text-gray-600 placeholder:opacity-100" /></label>
      <label class="block text-sm font-bold">TikTok (opcional)<input type="url" name="tiktok_url" maxlength="300" value={current.tiktok_url || ''} placeholder="https://www.tiktok.com/@usuario" class="mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 placeholder:text-gray-600 placeholder:opacity-100" /></label>
      <label class="block text-sm font-bold md:col-span-2">Dirección o referencia pública (opcional)<input name="address" maxlength="300" value={current.direccion || current.address || ''} class="mt-2 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 placeholder:text-gray-600 placeholder:opacity-100" /></label>
      <div class="rounded-2xl border border-gray-200 p-4 md:col-span-2">
        <p class="text-sm font-bold">Foto del perfil (cuadrada, 800 × 800 px)</p>
        
        {(profile?.imagen_url || application.image_url) && <img src={profile?.imagen_url || application.image_url} alt="Foto actual del perfil" width="160" height="160" class="mt-3 h-40 w-40 rounded-xl object-cover" />}
        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="mt-3 w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm" />
        <p class="mt-2 text-xs leading-5 text-gray-500">Sube JPG, PNG o WebP de hasta 8 MB y al menos 600 × 600 px. Al guardar se recorta a formato cuadrado, se convierte a WebP y se comprime hasta 450 KB.</p>
      </div>
      <button class="rounded-xl bg-[#243447] px-6 py-3 font-bold text-white md:col-span-2">{application.status === 'rejected' ? 'Guardar cambios y reenviar a revisión' : application.status === 'approved' ? 'Guardar cambios del perfil' : 'Guardar solicitud'}</button>
    </form>}
  </div></main>
</Layout>
<script is:inline>
  const deptSelect = document.getElementById('providerDepartment');
  const munSelect = document.getElementById('providerMunicipality');
  const munOptions = Array.from(munSelect?.options || []);
  const applyMunicipalityFilter = () => {
    const selected = deptSelect?.value || '';
    for (const option of munOptions) {
      if (!option.value) continue;
      option.hidden = Boolean(selected && option.dataset.department !== selected);
    }
    if (munSelect?.selectedOptions[0]?.dataset.department !== selected) munSelect.value = '';
  };
  deptSelect?.addEventListener('change', applyMunicipalityFilter);
  applyMunicipalityFilter();
</script>

<script is:inline>
  document.querySelectorAll('input[name="phone"], input[name="whatsapp"]').forEach((input) => {
    input.addEventListener('input', () => { input.value = input.value.replace(/\D/g, '').slice(0, 8); });
  });
</script>
