---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { hasAdminPermission, readAdminSessionToken, type AdminPermission } from '../../lib/admin-auth';

const session = await readAdminSessionToken(Astro.cookies.get('admin_session')?.value);
if (!session) return Astro.redirect('/sys-config-gt/login');

const sections: Array<{ title: string; description: string; href: string; icon: string; permission: AdminPermission; color: string }> = [
  {
    title: 'Usuarios',
    description: 'Crea cuentas, asigna roles y administra el acceso.',
    href: '/sys-config-gt/usuarios',
    icon: '👥',
    permission: 'usuarios',
    color: 'bg-[#F4EFE6] text-[#806B47]',
  },
  {
    title: 'Proveedores',
    description: 'Administra fichas, precios, publicaciones y proveedores.',
    href: '/sys-config-gt/proveedores',
    icon: '🏢',
    permission: 'proveedores',
    color: 'bg-[#EAF0F5] text-[#243447]',
  },
  {
    title: 'Estadísticas',
    description: 'Consulta vistas, contactos y CTR por proveedor.',
    href: '/sys-config-gt/dashboard',
    icon: '📊',
    permission: 'dashboard',
    color: 'bg-[#EAF4EE] text-[#39734A]',
  },
  {
    title: 'Categorías',
    description: 'Crea, edita y organiza las categorías de proveedores.',
    href: '/sys-config-gt/categorias',
    icon: '📂',
    permission: 'categorias',
    color: 'bg-[#F0ECF7] text-[#68508A]',
  },
].filter((section) => hasAdminPermission(session, section.permission));
---

<Layout title="Panel administrativo | Fiestas Guatemala">
  <main class="min-h-screen bg-[#F8F9FA] px-5 py-8 md:px-10 md:py-12 font-sans text-[#243447]">
    <div class="max-w-6xl mx-auto">
      <header class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between border-b border-gray-200 pb-7">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.2em] text-[#AD946D]">Fiestas Guatemala · Administración</p>
          <h1 class="mt-2 text-3xl md:text-4xl font-black italic">Panel de control</h1>
          <p class="mt-2 text-gray-500">Hola, {session.displayName}. Elige qué deseas administrar.</p>
        </div>
        <a href="/sys-config-gt/logout" class="inline-flex items-center justify-center rounded-xl border border-red-100 bg-red-50 px-5 py-3 text-xs font-black uppercase tracking-widest text-red-600 hover:bg-red-600 hover:text-white transition-colors">
          Cerrar sesión
        </a>
      </header>

      <section class="mt-8" aria-label="Secciones principales">
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
          {sections.map((section) => (
            <a href={section.href} class="group rounded-3xl border border-gray-100 bg-white p-6 md:p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-[#AD946D]/20">
              <div class={`mb-6 flex h-14 w-14 items-center justify-center rounded-2xl text-3xl ${section.color}`}>{section.icon}</div>
              <h2 class="text-xl font-black group-hover:text-[#AD946D] transition-colors">{section.title}</h2>
              <p class="mt-2 min-h-12 text-sm leading-6 text-gray-500">{section.description}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-[#AD946D]">
                Abrir sección <span aria-hidden="true">→</span>
              </span>
            </a>
          ))}
          {sections.length === 0 && (
            <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-900">
              Tu cuenta todavía no tiene secciones asignadas. Solicita al administrador que revise tu rol.
            </div>
          )}
        </div>
      </section>


      <footer class="mt-8 text-xs text-gray-400">
        Sesión: <span class="font-bold text-gray-500">{session.roleName}</span>
      </footer>
    </div>
  </main>
</Layout>
