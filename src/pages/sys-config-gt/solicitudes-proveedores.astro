---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { notifyIndexNow } from '../../lib/indexnow';
import { ensureProviderPlans } from '../../lib/provider-plans';
import { sql } from '@vercel/postgres';
import { Resend } from 'resend';
import { hasAdminPermission, isSameOriginRequest, readAdminSessionToken, writeAdminAudit } from '../../lib/admin-auth';
import { ensureProviderApplicationSchema, normalizeGuatemalaPhone, normalizeSlug } from '../../lib/provider-applications';

await ensureProviderApplicationSchema();
const session = await readAdminSessionToken(Astro.cookies.get('admin_session')?.value);
if (!hasAdminPermission(session, 'proveedores')) return Astro.redirect('/sys-config-gt/sin-permiso');

let actionError = '';
async function notifyProviderOfDecision(input: {
  email: string; companyName: string; status: 'approved' | 'rejected'; reason: string;
}): Promise<boolean> {
  const apiKey = process.env.RESEND_API_KEY;
  if (!apiKey) {
    console.error('No se envió el aviso de decisión: RESEND_API_KEY no está configurada.');
    return false;
  }
  const from = process.env.RESEND_FROM_EMAIL || 'Fiestas Guatemala <contacto@fiestasguatemala.com>';
  const approved = input.status === 'approved';
  const subject = approved ? 'Tu negocio fue aprobado en Fiestas Guatemala' : 'Actualización de tu solicitud en Fiestas Guatemala';
  const statusText = approved
    ? 'Tu solicitud para ' + input.companyName + ' fue aprobada y tu perfil ya está publicado en Fiestas Guatemala.'
    : 'Tu solicitud para ' + input.companyName + ' no fue aprobada.';
  const reasonText = approved || !input.reason ? '' : '\n\nMotivo indicado por el administrador: ' + input.reason;
  const safe = (value: string) => value.replace(/[&<>"']/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[character] || character));
  try {
    const result = await new Resend(apiKey).emails.send({
      from,
      to: input.email,
      subject,
      text: statusText + reasonText + '\n\nIngresa al área de proveedores de Fiestas Guatemala con tu correo y contraseña para consultar el estado de tu cuenta.',
      html: '<div style="font-family:Arial,sans-serif;max-width:560px;margin:auto;color:#243447">' +
        '<p>Fiestas Guatemala</p><h1>' + (approved ? '¡Tu negocio fue aprobado!' : 'Actualización de tu solicitud') +
        '</h1><p>' + safe(statusText) + '</p>' +
        (approved || !input.reason ? '' : '<p><strong>Motivo:</strong> ' + safe(input.reason) + '</p>') +
        '<p>Ingresa al área de proveedores con tu correo y contraseña para consultar el estado de tu cuenta.</p>' +
        '<p><a href="https://fiestasguatemala.com/proveedores">FiestasGuatemala.com</a></p></div>',
    });
    if (result.error) {
      console.error('Resend no aceptó el aviso de decisión al proveedor.', result.error);
      return false;
    }
    return true;
  } catch (error) {
    console.error('No se pudo enviar el aviso de decisión al proveedor.', error);
    return false;
  }
}

if (Astro.request.method === 'POST') {
  try {
    if (!isSameOriginRequest(Astro.request, Astro.url)) throw new Error('Solicitud no permitida.');
    const data = await Astro.request.formData();
    const id = Number(data.get('application_id'));
    const action = data.get('action')?.toString();
    const note = (data.get('admin_note')?.toString() || '').trim().slice(0, 1000);
    if (!Number.isSafeInteger(id) || id < 1) throw new Error('La solicitud enviada no es válida.');
    if (action === 'update-contact') {
      const phone = (data.get('phone')?.toString() || '').trim();
      const whatsapp = (data.get('whatsapp')?.toString() || '').trim();
      if (!/^\d{8}$/.test(phone) || !/^\d{8}$/.test(whatsapp)) throw new Error('Ingresa teléfono y WhatsApp con 8 dígitos, sin espacios ni letras.');
      const { rows: applicationRows } = await sql`SELECT provider_id, status FROM provider_applications WHERE id = ${id} LIMIT 1`;
      const application = applicationRows[0];
      if (!application || application.status !== 'pending') throw new Error('Solo puedes cambiar el contacto de una solicitud pendiente.');
      const { rows: duplicateRows } = await sql`
        SELECT id FROM proveedores
        WHERE regexp_replace(regexp_replace(COALESCE(whatsapp, ''), '[^0-9]', '', 'g'), '^502', '') = ${whatsapp}
          AND ( ${application.provider_id || null}::bigint IS NULL OR id <> ${application.provider_id || null} )
        LIMIT 1
      `;
      if (duplicateRows[0]) throw new Error('Este WhatsApp ya está asignado a otro proveedor. Verifica el número antes de guardar.');
      await sql`UPDATE provider_applications SET phone = ${phone}, whatsapp = ${whatsapp}, updated_at = NOW() WHERE id = ${id} AND status = 'pending'`;
      if (application.provider_id) await sql`UPDATE proveedores SET telefono = ${phone}, whatsapp = ${whatsapp} WHERE id = ${application.provider_id}`;
      await writeAdminAudit(session, 'actualizar_contacto', 'solicitud_proveedor', String(id), { phone, whatsapp });
      return Astro.redirect('/sys-config-gt/solicitudes-proveedores?actualizado=contacto');
    }
    if (!['approve', 'reject'].includes(action || '')) throw new Error('La solicitud enviada no es válida.');

    if (action === 'reject') {
      if (!note) throw new Error('Escribe la razón de no aprobación para que el proveedor pueda verla.');
      const { rows: rejectedRows } = await sql`UPDATE provider_applications SET status = 'rejected', admin_note = ${note}, reviewed_by = ${session?.userId || null}, reviewed_at = NOW(), updated_at = NOW() WHERE id = ${id} AND status = 'pending' RETURNING contact_email, company_name`;
      const rejected = rejectedRows[0];
      if (!rejected) throw new Error('La solicitud ya fue revisada o no existe.');
      await writeAdminAudit(session, 'rechazar', 'solicitud_proveedor', String(id), { note });
      const emailAccepted = await notifyProviderOfDecision({
        email: rejected.contact_email, companyName: rejected.company_name, status: 'rejected', reason: note,
      });
      return Astro.redirect('/sys-config-gt/solicitudes-proveedores?actualizado=rechazada&correo=' + (emailAccepted ? 'aceptado' : 'fallo'));
    }

    await ensureProviderPlans();
    const { rows: claimedRows } = await sql`UPDATE provider_applications SET status = 'processing', updated_at = NOW() WHERE id = ${id} AND status = 'pending' RETURNING *`;
    const application = claimedRows[0];
    if (!application) throw new Error('La solicitud ya fue revisada o no existe.');

    try {
      const { rows: duplicateRows } = await sql`
        SELECT id FROM proveedores
        WHERE regexp_replace(regexp_replace(COALESCE(whatsapp, ''), '[^0-9]', '', 'g'), '^502', '') = ${application.whatsapp}
          AND ( ${application.provider_id || null}::bigint IS NULL OR id <> ${application.provider_id || null} )
        LIMIT 1
      `;
      if (duplicateRows[0]) throw new Error('Este WhatsApp ya está asignado a otro proveedor. Actualiza el contacto de la solicitud antes de aprobar.');
      const { rows: categoryRows } = await sql`SELECT imagen_url FROM categorias WHERE slug = ${application.category_slug} LIMIT 1`;
      if (!categoryRows[0]) throw new Error('La categoría ya no existe. Actualiza la solicitud antes de aprobarla.');
      const imageUrl = application.image_url || categoryRows[0].imagen_url || 'https://fiestasguatemala.com/Logo-Fiestas-Guatemala.jpg';
      let providerId = application.provider_id ? Number(application.provider_id) : null;
      if (providerId) {
        const { rows: providerRows } = await sql`
          UPDATE proveedores SET nombre = ${application.company_name}, descripcion = ${application.description},
            telefono = ${application.phone}, email = ${application.contact_email}, instagram_url = ${application.instagram_url},
            tiktok_url = ${application.tiktok_url}, direccion = ${application.address}, whatsapp = ${application.whatsapp},
            municipio = ${application.municipality}, departamento = ${application.department},
            categoria_slug = ${application.category_slug}, precio_desde = ${application.price_from},
            imagen_url = ${imageUrl}, activo = TRUE
          WHERE id = ${providerId}
          RETURNING id
        `;
        if (!providerRows[0]) throw new Error('La ficha asociada ya no existe.');
      } else {
        const baseSlug = normalizeSlug(application.company_name) || 'proveedor';
        const providerSlug = baseSlug + '-' + String(application.id);
        const { rows: providerRows } = await sql`
          INSERT INTO proveedores
            (nombre, slug, descripcion, telefono, email, instagram_url, tiktok_url, direccion, whatsapp,
             municipio, departamento, categoria_slug, precio_desde, imagen_url, es_premium, verificado, activo)
          VALUES
            (${application.company_name}, ${providerSlug}, ${application.description}, ${application.phone},
             ${application.contact_email}, ${application.instagram_url}, ${application.tiktok_url},
             ${application.address}, ${application.whatsapp}, ${application.municipality}, ${application.department},
             ${application.category_slug}, ${application.price_from}, ${imageUrl}, FALSE, FALSE, TRUE)
          RETURNING id
        `;
        providerId = Number(providerRows[0].id);
      }
      await sql`UPDATE provider_applications SET status = 'approved', admin_note = ${note}, provider_id = ${providerId}, reviewed_by = ${session?.userId || null}, reviewed_at = NOW(), updated_at = NOW() WHERE id = ${id} AND status = 'processing'`;
      try {
        const { rows } = await sql`SELECT categoria_slug, slug FROM proveedores WHERE id = ${providerId} AND activo = TRUE`;
        if (rows[0]) await notifyIndexNow('/' + rows[0].categoria_slug, '/' + rows[0].categoria_slug + '/' + rows[0].slug);
      } catch (error) { console.warn('No se pudo localizar la URL publicada:', error); }
      await writeAdminAudit(session, 'aprobar', 'solicitud_proveedor', String(id), { providerId, email: application.contact_email });
      const emailAccepted = await notifyProviderOfDecision({
        email: application.contact_email, companyName: application.company_name, status: 'approved', reason: '',
      });
      return Astro.redirect('/sys-config-gt/solicitudes-proveedores?actualizado=aprobada&correo=' + (emailAccepted ? 'aceptado' : 'fallo'));
    } catch (error) {
      await sql`UPDATE provider_applications SET status = 'pending', updated_at = NOW() WHERE id = ${id} AND status = 'processing'`;
      throw error;
    }
  } catch (error) {
    const detail = error instanceof Error ? error.message : '';
    actionError = detail.includes('unique_whatsapp') || detail.includes('duplicate key')
      ? 'No se pudo aprobar: este WhatsApp ya está asignado a otro proveedor. Verifica el número y vuelve a intentarlo.'
      : detail || 'No se pudo procesar la solicitud.';
  }
}
const { rows: applications } = await sql`
  SELECT a.*, c.nombre AS category_name
  FROM provider_applications a LEFT JOIN categorias c ON c.slug = a.category_slug
  ORDER BY CASE a.status WHEN 'pending' THEN 0 WHEN 'processing' THEN 1 ELSE 2 END, a.created_at DESC
  LIMIT 300
`;
const statusLabels: Record<string, string> = { pending: 'Pendiente', processing: 'Procesando', approved: 'Aprobada', rejected: 'No aprobada' };
---
<Layout title="Solicitudes de proveedores | Administración">
  <main class="min-h-screen bg-[#F8F9FA] p-5 text-[#243447] md:p-10"><div class="mx-auto max-w-7xl space-y-7">
    <header class="border-b border-gray-200 pb-6"><a href="/sys-config-gt" class="text-xs font-bold text-[#AD946D]">← Panel de control</a><div class="mt-3 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><h1 class="text-3xl font-black">Solicitudes de proveedores</h1><p class="mt-2 text-sm text-gray-500">Correos verificados · Términos aceptados · Aprobación manual</p></div><a href="/proveedores/registro" target="_blank" rel="noopener" class="rounded-xl bg-[#243447] px-4 py-3 text-center text-xs font-bold text-white">Ver formulario público</a></div></header>
    {Astro.url.searchParams.get('actualizado') === 'contacto' && <p role="status" class="rounded-xl bg-green-50 p-4 text-sm text-green-800">Los datos de contacto se actualizaron.</p>}
    {['aprobada', 'rechazada'].includes(Astro.url.searchParams.get('actualizado') || '') && <div role="status" class="rounded-xl bg-green-50 p-4 text-sm text-green-800"><p>La solicitud se procesó correctamente.</p><p class="mt-1">{Astro.url.searchParams.get('correo') === 'aceptado' ? 'Resend aceptó el aviso por correo para el proveedor.' : 'No se pudo enviar el aviso por correo al proveedor; revisa los registros de Vercel y Resend.'}</p></div>}
    {actionError && <p role="alert" class="rounded-xl bg-red-50 p-4 text-sm text-red-700">{actionError}</p>}
    <section class="space-y-5">
      {applications.map((application) => (
        <article class="rounded-3xl border border-gray-100 bg-white p-5 shadow-sm md:p-7">
          <div class="flex flex-col justify-between gap-3 border-b pb-4 sm:flex-row"><div><div class="flex flex-wrap items-center gap-2"><h2 class="text-xl font-black">{application.company_name}</h2><span class:list={['rounded-full px-3 py-1 text-xs font-bold', application.status === 'pending' ? 'bg-amber-50 text-amber-800' : application.status === 'approved' ? 'bg-green-50 text-green-800' : application.status === 'rejected' ? 'bg-red-50 text-red-700' : 'bg-blue-50 text-blue-800']}>{statusLabels[application.status] || application.status}</span></div><p class="mt-1 text-sm text-gray-500">{application.category_name || application.category_slug} · {application.municipality}, {application.department}</p></div><p class="text-xs text-gray-400">{new Date(application.created_at).toLocaleString('es-GT')}</p></div>
          <div class="grid gap-5 py-5 md:grid-cols-2">
            <div class="space-y-2 text-sm"><p><strong>Correo verificado:</strong> <a class="text-blue-700 underline" href={'mailto:' + application.contact_email}>{application.contact_email}</a></p><p><strong>WhatsApp:</strong> {application.whatsapp}</p><p><strong>Teléfono:</strong> {application.phone || 'No indicado'}</p><p><strong>Precio mínimo:</strong> {application.price_from > 0 ? 'Q' + application.price_from : 'No indicado'}</p><p><strong>Imagen:</strong> {application.image_url ? <a href={application.image_url} target="_blank" rel="noopener" class="text-blue-700 underline">Abrir</a> : 'Usará imagen de categoría/logo del directorio'}</p><p><strong>Instagram:</strong> {application.instagram_url || '—'}</p><p><strong>TikTok:</strong> {application.tiktok_url || '—'}</p><p><strong>Dirección pública:</strong> {application.address || '—'}</p><p><strong>Términos:</strong> {application.terms_version}</p></div>
            <p class="whitespace-pre-line rounded-2xl bg-gray-50 p-4 text-sm leading-6">{application.description}</p>
          </div>
          {application.admin_note && <p class="mb-4 rounded-xl bg-gray-50 p-3 text-sm"><strong>Nota de revisión:</strong> {application.admin_note}</p>}
          {application.status === 'pending' && <form method="POST" class="mb-4 grid gap-3 rounded-2xl bg-gray-50 p-4 sm:grid-cols-[1fr_1fr_auto]"><input type="hidden" name="action" value="update-contact" /><input type="hidden" name="application_id" value={application.id} /><label class="text-xs font-bold">Teléfono<input name="phone" type="tel" inputmode="numeric" pattern="[0-9]{8}" minlength="8" maxlength="8" required value={normalizeGuatemalaPhone(application.phone || '')} placeholder="8 dígitos, sin espacios" class="mt-1 w-full rounded-lg border bg-white px-3 py-2 placeholder:text-gray-600 placeholder:opacity-100" /></label><label class="text-xs font-bold">WhatsApp<input name="whatsapp" type="tel" inputmode="numeric" pattern="[0-9]{8}" minlength="8" maxlength="8" required value={normalizeGuatemalaPhone(application.whatsapp || '')} placeholder="8 dígitos, sin espacios" class="mt-1 w-full rounded-lg border bg-white px-3 py-2 placeholder:text-gray-600 placeholder:opacity-100" /></label><button class="self-end rounded-xl bg-[#243447] px-4 py-2 text-sm font-bold text-white">Guardar contacto</button></form>}
          {application.status === 'pending' && <form method="POST" class="grid gap-3 border-t pt-4 sm:grid-cols-[1fr_auto_auto]"><input type="hidden" name="application_id" value={application.id} /><textarea name="admin_note" maxlength="1000" rows="2" placeholder="Nota opcional al aprobar; razón obligatoria y visible al proveedor si rechazas" class="rounded-xl border bg-gray-50 px-4 py-3 text-sm"></textarea><button name="action" value="approve" class="rounded-xl bg-green-700 px-5 py-3 text-sm font-bold text-white">Aprobar y publicar</button><button name="action" value="reject" class="rounded-xl bg-red-50 px-5 py-3 text-sm font-bold text-red-700">Rechazar</button></form>}
          {application.status === 'approved' && application.provider_id && <p class="text-sm font-semibold text-green-800">Proveedor publicado. <a class="underline" href={'/' + application.category_slug + '/' + normalizeSlug(application.company_name) + '-' + application.id}>Abrir ficha</a></p>}
        </article>
      ))}
      {applications.length === 0 && <div class="rounded-3xl bg-white p-10 text-center text-gray-500">Aún no hay solicitudes.</div>}
    </section>
  </div></main>
</Layout>

<script is:inline>
  document.querySelectorAll('input[name="phone"], input[name="whatsapp"]').forEach((input) => {
    input.addEventListener('input', () => { input.value = input.value.replace(/\D/g, '').slice(0, 8); });
  });
</script>
