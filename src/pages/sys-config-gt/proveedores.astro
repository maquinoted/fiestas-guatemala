---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { sql } from '@vercel/postgres';
import { hasAdminPermission, readAdminSessionToken } from '../../lib/admin-auth';

// 🔥 PARCHE DE EMERGENCIA: Si el Layout no carga el CSS, lo forzamos aquí
import '../../styles/global.css'; 

Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');
const adminSession = await readAdminSessionToken(Astro.cookies.get('admin_session')?.value);

let proveedores = [];
try {
  const { rows } = await sql`
    SELECT id, nombre, municipio, categoria_slug, activo, es_premium, precio_desde 
    FROM proveedores 
    ORDER BY activo DESC, nombre ASC
  `;
  proveedores = rows;
} catch (e) { console.error("Error cargando proveedores:", e); }

const totalActivos = proveedores.filter(p => p.activo).length;
---

<Layout title="Control de Inventario | Oficina Central">
  <style>
    .modal-overlay {
      background: rgba(36, 52, 71, 0.8);
      backdrop-filter: blur(4px);
    }
    .animate-in {
      animation: scaleIn 0.3s ease-out;
    }
    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
  </style>

  <div class="p-4 md:p-12">
    <div class="max-w-6xl mx-auto">
      <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-6">
        <div>
          <h1 class="text-3xl font-black tracking-tight italic text-[#243447]">Panel de Control 📋</h1>
          <p class="text-gray-500 font-medium">
            Mijo, tenés <span class="text-[#a68a56] font-bold">{totalActivos}</span> servicios activos.
          </p>
        </div>
        <nav class="flex flex-wrap gap-2 w-full md:w-auto">
          <a href="/sys-config-gt" class="bg-white text-[#243447] px-4 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest border border-gray-200 shadow-sm hover:bg-gray-50">Panel</a>
          {hasAdminPermission(adminSession, 'usuarios') && <a href="/sys-config-gt/usuarios" class="bg-white text-[#243447] px-4 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest border border-gray-200 shadow-sm hover:bg-gray-50">Usuarios y roles</a>}
          {hasAdminPermission(adminSession, 'categorias') && <a href="/sys-config-gt/categorias" class="bg-white text-[#243447] px-4 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest border border-gray-200 shadow-sm hover:bg-gray-50">Categorías</a>}
          {hasAdminPermission(adminSession, 'dashboard') && <a href="/sys-config-gt/dashboard" class="bg-white text-[#243447] px-4 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest border border-gray-200 shadow-sm hover:bg-gray-50">Estadísticas</a>}
          <a href="/sys-config-gt/logout" class="bg-red-50 text-red-600 px-4 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest border border-red-100 hover:bg-red-600 hover:text-white">Salir</a>
          <a href="/sys-config-gt/nuevoProveedor" class="bg-[#243447] text-white px-5 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest text-center hover:bg-black shadow-sm">+ Proveedor</a>
        </nav>
      </header>

      <div class="bg-white rounded-[40px] shadow-xl border border-gray-100 overflow-hidden">
        <div class="border-b border-gray-100 px-6 py-6 md:px-8">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="relative w-full sm:max-w-md">
              <label for="proveedorSearch" class="mb-2 block text-[10px] font-black uppercase tracking-widest text-gray-400">Buscar proveedor</label>
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-gray-400" aria-hidden="true">⌕</span>
                <input id="proveedorSearch" type="search" autocomplete="off" placeholder="Nombre, municipio o categoría..." class="w-full rounded-2xl border border-gray-200 bg-gray-50 py-3 pl-11 pr-24 text-sm font-medium text-[#243447] outline-none transition focus:border-[#a68a56] focus:bg-white focus:ring-2 focus:ring-[#a68a56]/15" />
                <button id="clearProveedorSearch" type="button" class="absolute inset-y-1.5 right-1.5 rounded-xl px-3 text-[10px] font-black uppercase tracking-wider text-gray-500 transition hover:bg-gray-200 hover:text-[#243447]">Limpiar</button>
              </div>
            </div>
            <p id="proveedorSearchCount" class="text-xs font-semibold text-gray-500" aria-live="polite"></p>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[800px]">
            <thead>
              <tr class="bg-gray-50/50 text-[10px] uppercase font-black text-gray-400 tracking-[0.2em]">
                <th class="px-8 py-6">Proveedor</th>
                <th class="px-8 py-6 text-center">Estado</th>
                <th class="px-8 py-6 text-center">Categoría</th>
                <th class="px-8 py-6 text-center">Inversión</th>
                <th class="px-8 py-6 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {proveedores.map(p => (
                <tr data-proveedor-row data-search={`${p.nombre ?? ''} ${p.municipio ?? ''} ${p.categoria_slug ?? ''} ${p.activo ? 'publicado activo' : 'pausado inactivo'}`} class={`border-b border-gray-50 hover:bg-[#F5F3E7]/30 transition-all group ${!p.activo ? 'opacity-40 grayscale' : ''}`}>
                  <td class="px-8 py-6">
                    <div>
                      <p class="font-bold text-lg text-[#243447] group-hover:text-[#a68a56] transition-colors">{p.nombre}</p>
                      <p class="text-[10px] text-gray-400 font-black uppercase tracking-widest">📍 {p.municipio}</p>
                    </div>
                  </td>
                  <td class="px-8 py-6 text-center">
                    <span class={`text-[9px] font-black uppercase px-3 py-1.5 rounded-full ${p.activo ? 'bg-green-100 text-green-700' : 'bg-gray-200 text-gray-500'}`}>{p.activo ? '● Publicado' : '○ Pausado'}</span>
                  </td>
                  <td class="px-8 py-6 text-center">
                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest bg-gray-50 px-3 py-1 rounded-lg">{p.categoria_slug}</span>
                  </td>
                  <td class="px-8 py-6 text-center"><p class="font-black text-[#243447]">{p.precio_desde > 0 ? `Q${p.precio_desde}` : 'Consultar'}</p></td>
                  <td class="px-8 py-6 text-right space-x-3">
                    <a href={`/sys-config-gt/editar/${p.id}`} class="text-[10px] font-black uppercase tracking-widest text-[#AD946D] hover:text-[#243447] no-underline">Editar</a>
                    <button 
                      onclick={`openModal(${p.id}, ${p.activo})`}
                      class={`text-[10px] font-black uppercase tracking-widest transition-colors ${p.activo ? 'text-red-300 hover:text-red-600' : 'text-green-300 hover:text-green-600'}`}
                    >
                      {p.activo ? 'Baja' : 'Activar'}
                    </button>
                  </td>
                </tr>
              ))}
              <tr id="noProveedorResults" class="hidden">
                <td colspan="5" class="px-8 py-12 text-center text-sm font-medium text-gray-400">No se encontraron proveedores con esa búsqueda.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div id="statusModal" class="hidden fixed inset-0 modal-overlay z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-[35px] shadow-2xl p-8 max-w-sm w-full animate-in text-center space-y-6">
      <div class="text-3xl">🛎️</div>
      <h3 id="modalTitle" class="font-serif text-2xl text-[#243447]">¿Confirmar cambio?</h3>
      <p class="text-gray-500 text-sm font-light leading-relaxed px-4">Esto cambiará la visibilidad del servicio en tiempo real, mijo.</p>
      <div class="grid grid-cols-2 gap-3 pt-4 border-t border-gray-50">
        <button onclick="closeModal()" class="bg-gray-50 text-gray-400 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest">Cancelar</button>
        <button id="modalConfirmBtn" class="bg-[#243447] text-white py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest shadow-lg">Confirmar 🚀</button>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  let currentId = null;
  let currentStatus = null;
  const modal = document.getElementById('statusModal');
  const modalTitle = document.getElementById('modalTitle');
  const confirmBtn = document.getElementById('modalConfirmBtn');
  const proveedorSearch = document.getElementById('proveedorSearch');
  const clearProveedorSearch = document.getElementById('clearProveedorSearch');
  const proveedorRows = Array.from(document.querySelectorAll('[data-proveedor-row]'));
  const noProveedorResults = document.getElementById('noProveedorResults');
  const proveedorSearchCount = document.getElementById('proveedorSearchCount');

  function normalizeSearch(value) {
    return (value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es').trim();
  }

  function filterProveedores() {
    const query = normalizeSearch(proveedorSearch?.value);
    let visible = 0;
    proveedorRows.forEach(row => {
      const matches = normalizeSearch(row.dataset.search).includes(query);
      row.classList.toggle('hidden', !matches);
      if (matches) visible++;
    });
    noProveedorResults?.classList.toggle('hidden', visible !== 0);
    if (proveedorSearchCount) proveedorSearchCount.textContent = 'Mostrando ' + visible + ' de ' + proveedorRows.length + ' proveedores';
  }

  proveedorSearch?.addEventListener('input', filterProveedores);
  clearProveedorSearch?.addEventListener('click', () => {
    if (!proveedorSearch) return;
    proveedorSearch.value = '';
    filterProveedores();
    proveedorSearch.focus();
  });
  filterProveedores();


  function openModal(id, status) {
    currentId = id;
    currentStatus = status;
    modalTitle.innerHTML = status ? '¿Dar de <span class="text-red-500">baja</span>?' : '¿<span class="text-green-500">Activar</span> servicio?';
    modal.classList.remove('hidden');
  }

  function closeModal() {
    modal.classList.add('hidden');
  }

  confirmBtn?.addEventListener('click', async () => {
    confirmBtn.innerText = 'Procesando...';
    const res = await fetch('/api/toggle-activo', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: currentId, nuevoEstado: !currentStatus })
    });
    if (res.ok) window.location.reload();
  });
</script>