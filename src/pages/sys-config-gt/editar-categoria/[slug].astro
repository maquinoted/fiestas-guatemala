---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { sql } from '@vercel/postgres';
import { ensureProviderApplicationSchema, normalizeSlug } from '../../../lib/provider-applications';

await ensureProviderApplicationSchema();

const { slug } = Astro.params;

// 1. Cargar datos actuales (incluyendo la imagen)
const { rows } = await sql`SELECT * FROM categorias WHERE slug = ${slug}`;
const cat = rows[0];

if (!cat) return Astro.redirect('/sys-config-gt/categorias');

let mensaje = "";
let error = false;

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const nombre = (data.get("nombre") as string || "").trim();
    const icono = (data.get("icono") as string || "").trim();
    const descripcion = (data.get("descripcion") as string || "").trim();
    const imagen_url = (data.get("imagen_url") as string || "").trim();
    const nuevoSlug = normalizeSlug(data.get("slug") as string || "");
    if (!nuevoSlug) throw new Error("Escribe un slug válido para la URL.");
    const { rows: duplicados } = await sql`SELECT id FROM categorias WHERE slug = ${nuevoSlug} AND slug <> ${slug} LIMIT 1`;
    if (duplicados[0]) throw new Error("Ese slug ya lo usa otra categoría.");

    if (nuevoSlug !== slug) {
      const { rows: slugForeignKeys } = await sql`
        SELECT confupdtype
        FROM pg_constraint
        WHERE conname = 'proveedores_categoria_slug_fkey'
          AND conrelid = 'proveedores'::regclass
        LIMIT 1
      `;
      if (slugForeignKeys[0] && slugForeignKeys[0].confupdtype !== 'c') {
        const { rows: cascadeForeignKeys } = await sql`
          SELECT conname FROM pg_constraint
          WHERE conname = 'proveedores_categoria_slug_update_fkey'
            AND conrelid = 'proveedores'::regclass
          LIMIT 1
        `;
        if (!cascadeForeignKeys[0]) {
          await sql`
            ALTER TABLE proveedores
            ADD CONSTRAINT proveedores_categoria_slug_update_fkey
            FOREIGN KEY (categoria_slug) REFERENCES categorias(slug) ON UPDATE CASCADE
          `;
        }
        await sql`ALTER TABLE proveedores DROP CONSTRAINT proveedores_categoria_slug_fkey`;
      }
    }

    if (nuevoSlug === slug) {
      // Si solo se edita el contenido, no actualizar la columna referenciada por la clave foránea.
      await sql`
        UPDATE categorias
        SET nombre = ${nombre}, icono = ${icono},
            descripcion = ${descripcion}, imagen_url = ${imagen_url}
        WHERE slug = ${slug}
      `;
    } else {
      // La clave foránea propaga el slug nuevo a los proveedores relacionados.
      await sql`
        UPDATE categorias
        SET nombre = ${nombre}, slug = ${nuevoSlug}, icono = ${icono},
            descripcion = ${descripcion}, imagen_url = ${imagen_url}
        WHERE slug = ${slug}
      `;
      await sql`UPDATE proveedores SET categoria_slug = ${nuevoSlug} WHERE categoria_slug = ${slug}`;
      await sql`INSERT INTO category_slug_redirects (old_slug, new_slug) VALUES (${slug}, ${nuevoSlug}) ON CONFLICT (old_slug) DO UPDATE SET new_slug = EXCLUDED.new_slug, updated_at = NOW()`;
    }
    return Astro.redirect('/sys-config-gt/categorias');
  } catch (e: any) {
    console.error(e);
    error = true;
    mensaje = "Huy mijo, no se pudo actualizar: " + e.message;
  }
}
---

<Layout title={`Editar Categoría: ${cat.nombre}`}>
  <div class="bg-[#F8F9FA] min-h-screen p-6 md:p-12 font-sans text-[#243447]">
    <div class="max-w-2xl mx-auto">
      
      <header class="mb-10">
        <a href="/sys-config-gt/categorias" class="text-[10px] font-black uppercase tracking-widest text-[#705930]">← Cancelar y Volver</a>
        <h1 class="text-4xl font-black mt-2 italic text-[#243447]">Editar Estructura</h1>
        <p class="text-[10px] font-mono text-gray-400 mt-1 uppercase">Slug actual: {cat.slug}</p>
      </header>

      <form method="POST" class="bg-white p-8 md:p-12 rounded-[40px] shadow-2xl space-y-8 border border-gray-100">
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="md:col-span-3">
            <label class="block text-[10px] font-black uppercase text-gray-400 mb-2 tracking-widest">Nombre Visible</label>
            <input type="text" name="nombre" value={cat.nombre} required class="w-full px-6 py-4 rounded-2xl bg-gray-50 border-none font-bold text-lg focus:ring-2 focus:ring-[#705930] transition-all" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase text-gray-400 mb-2 text-center tracking-widest">Icono</label>
            <input type="text" name="icono" value={cat.icono} required class="w-full px-6 py-4 rounded-2xl bg-gray-50 border-none font-bold text-center text-2xl focus:ring-2 focus:ring-[#705930] transition-all" />
          </div>
        </div>

        <div>
          <label class="block text-[10px] font-black uppercase text-gray-400 mb-2 tracking-widest">Slug de la URL pública</label>
          <input type="text" name="slug" value={cat.slug} required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" maxlength="90" class="w-full px-6 py-4 rounded-2xl bg-gray-50 border-none font-mono text-sm focus:ring-2 focus:ring-[#705930] transition-all" />
          <p class="mt-2 text-xs text-gray-500">La URL pública se actualizará. Los enlaces anteriores redirigirán automáticamente.</p>
        </div>

        <div>
          <label class="block text-[10px] font-black uppercase text-gray-400 mb-2 tracking-widest">URL del Banner (Imagen Principal)</label>
          <input 
            type="url" 
            name="imagen_url" 
            value={cat.imagen_url} 
            placeholder="https://tusitio.com/imagen.webp" 
            class="w-full px-6 py-4 rounded-2xl bg-gray-50 border-none font-medium text-sm focus:ring-2 focus:ring-[#705930] transition-all" 
          />
          <p class="text-[9px] text-gray-400 mt-2 italic font-medium">✨ Pro tip de Claudia: Usá WebP de 1200x630px para que brille en Google.</p>
        </div>

        <div>
          <label class="block text-[10px] font-black uppercase text-gray-400 mb-2 tracking-widest">Descripción SEO</label>
          <textarea name="descripcion" rows="4" class="w-full px-6 py-4 rounded-2xl bg-gray-50 border-none text-sm leading-relaxed focus:ring-2 focus:ring-[#705930] transition-all">{cat.descripcion}</textarea>
        </div>

        <button type="submit" class="w-full bg-[#243447] text-white py-6 rounded-[25px] font-black uppercase text-[12px] tracking-[0.2em] shadow-xl hover:bg-black hover:-translate-y-1 transition-all active:scale-95">
          Guardar Cambios en {cat.nombre} 🚀
        </button>

        {error && (
          <div class="bg-red-50 p-4 rounded-2xl text-center text-red-600 border border-red-100 text-[10px] font-black uppercase">
            {mensaje}
          </div>
        )}
      </form>
      
      <div class="mt-8 pt-8 border-t border-gray-100 flex items-center justify-between">
         <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest">FiestasGuatemala.com • Core Engine</p>
         <span class="text-xs grayscale opacity-30">🇬🇹</span>
      </div>
    </div>
  </div>
</Layout>