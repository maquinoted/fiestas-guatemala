---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { sql } from '@vercel/postgres';

import { ensureProviderMetrics } from '../../lib/provider-metrics';
await ensureProviderMetrics();

const { rows: stats } = await sql`
  WITH daily AS (
    SELECT provider_id, day, visitor_key,
      BOOL_OR(action = 'view') AS visto,
      BOOL_OR(action = 'whatsapp') AS wa,
      BOOL_OR(action = 'call') AS tel,
      BOOL_OR(action = 'instagram') AS ig,
      BOOL_OR(action = 'tiktok') AS tt,\n      BOOL_OR(action = 'waze') AS waze,
      BOOL_OR(action = 'favorite') AS favorito
    FROM provider_daily_events
    GROUP BY provider_id, day, visitor_key
  )
  SELECT p.id, p.nombre,
    COUNT(*) FILTER (WHERE d.visto)::int AS vistas,
    COUNT(*) FILTER (WHERE d.wa)::int AS whatsapp,
    COUNT(*) FILTER (WHERE d.tel)::int AS llamadas,
    COUNT(*) FILTER (WHERE d.ig)::int AS instagram,
    COUNT(*) FILTER (WHERE d.tt)::int AS tiktok,\n    COUNT(*) FILTER (WHERE d.waze)::int AS waze,
    COUNT(*) FILTER (WHERE d.favorito)::int AS favoritos,
    COUNT(*) FILTER (WHERE d.visto AND (d.wa OR d.tel))::int AS contactos
  FROM proveedores p LEFT JOIN daily d ON p.id = d.provider_id
  GROUP BY p.id, p.nombre ORDER BY vistas DESC, p.nombre
`;
const totalVistas = stats.reduce((sum, s) => sum + s.vistas, 0);
const totalLeads = stats.reduce((sum, s) => sum + s.contactos, 0);
const ctr = (contacts: number, views: number) => views ? ((contacts / views) * 100).toFixed(2) : '0.00';
const ctrGlobal = ctr(totalLeads, totalVistas);
---

<Layout title="Performance Comercial | Fiestas Guatemala">
  <div class="p-8 bg-[#F8F9FA] min-h-screen font-sans text-[#243447]">
    <div class="max-w-7xl mx-auto">
      <header class="mb-10 flex flex-col md:flex-row justify-between items-center border-b pb-8 gap-4">
        <div>
          <h1 class="text-4xl font-black italic">Performance Comercial 📊</h1>
          <p class="text-xs font-bold text-[#AD946D] uppercase tracking-widest mt-1">Actividad única por proveedor y día · hora de Guatemala</p>
        </div>
        <a href="/sys-config-gt" class="bg-white border px-6 py-3 rounded-full text-[10px] font-black uppercase">← Panel de control</a>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10 text-center md:text-left">
        <div class="bg-white p-8 rounded-[35px] shadow-xl border border-white">
          <p class="text-[10px] font-black uppercase text-gray-400 mb-2">Vistas Totales</p>
          <p class="text-4xl font-serif italic">{totalVistas}</p>
        </div>
        <div class="bg-[#243447] p-8 rounded-[35px] shadow-xl">
          <p class="text-[10px] font-black uppercase text-[#AD946D] mb-2">Visitas con clic de contacto</p>
          <p class="text-4xl font-serif italic text-white">{totalLeads}</p>
        </div>
        <div class="bg-white p-8 rounded-[35px] shadow-xl border border-white">
          <p class="text-[10px] font-black uppercase text-gray-400 mb-2">CTR Global</p>
          <p class="text-4xl font-serif italic text-[#AD946D]">{ctrGlobal}%</p>
        </div>
      </div>
      
      <div class="bg-white rounded-[45px] shadow-2xl overflow-x-auto border border-gray-100">
        <table class="w-full min-w-[980px] text-left">
          <thead class="bg-[#243447] text-white uppercase text-[10px] font-black tracking-widest">
            <tr>
              <th class="p-8">Proveedor</th>
              <th class="p-8 text-center border-l border-white/5">Vistas</th>
              <th class="p-8 text-center border-l border-white/5">WA</th>
              <th class="p-8 text-center border-l border-white/5">Tel</th>
              <th class="p-8 text-center border-l border-white/5">Instagram</th>
              <th class="p-8 text-center border-l border-white/5">TikTok</th>\n              <th class="p-8 text-center border-l border-white/5">Waze</th>
              <th class="p-8 text-center border-l border-white/5">Favoritos</th>
              <th class="p-8 text-center border-l border-white/5 bg-[#1a2633]">Visitas con contacto</th>
              <th class="p-8 text-center border-l border-white/5 bg-[#AD946D]">CTR %</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            {stats.map(s => (
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="p-8 font-bold text-[#243447]">{s.nombre}</td>
                <td class="p-8 text-center text-gray-400 font-bold">{s.vistas}</td>
                <td class="p-8 text-center text-green-600 font-bold">{s.whatsapp}</td>
                <td class="p-8 text-center text-blue-600 font-bold">{s.llamadas}</td>
                <td class="p-8 text-center text-gray-600 font-bold">{s.instagram}</td>
                <td class="p-8 text-center text-gray-600 font-bold">{s.tiktok}</td>\n                <td class="p-8 text-center text-gray-600 font-bold">{s.waze}</td>
                <td class="p-8 text-center text-gray-600 font-bold">{s.favoritos}</td>
                <td class="p-8 text-center font-black text-[#243447] bg-gray-50/50">{s.contactos}</td>
                <td class={`p-8 text-center font-black ${Number(ctr(s.contactos, s.vistas)) > 10 ? 'text-green-600' : 'text-[#AD946D]'}`}>{ctr(s.contactos, s.vistas)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>