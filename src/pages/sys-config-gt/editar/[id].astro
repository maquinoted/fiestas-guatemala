---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro'; 
import { notifyIndexNow } from '../../../lib/indexnow';
import { ensureMonthlyReports } from '../../../lib/provider-reports';
import { formatPlanDate, getProviderPlan } from '../../../lib/provider-plans';
import { isSameOriginRequest } from '../../../lib/admin-auth';
import { sql } from '@vercel/postgres';
import { put } from '@vercel/blob';
import sharp from 'sharp';
import { ensureProviderDetailsSchema, normalizeGuatemalaPhone } from '../../../lib/provider-applications';

const { id } = Astro.params;

// Asegura que las fichas antiguas también puedan guardar información ampliada.
await ensureProviderDetailsSchema();

// 1. Traemos los datos actuales
const { rows } = await sql`SELECT * FROM proveedores WHERE id = ${id}`;
const p = rows[0];

if (!p) return Astro.redirect('/sys-config-gt/proveedores');
const plan = await getProviderPlan(Number(id));
await ensureMonthlyReports();
const { rows: reports } = await sql`SELECT body, recipient, sent_at FROM provider_monthly_reports WHERE provider_id = ${id} ORDER BY month DESC LIMIT 1`;
const { rows: inquiries } = await sql`SELECT sender_name, sender_email, message, created_at FROM provider_inquiries WHERE provider_id = ${id} ORDER BY created_at DESC LIMIT 50`;

const { rows: categoriasDB } = await sql`SELECT slug, nombre FROM categorias ORDER BY nombre ASC`;
const { rows: departamentosDB } = await sql`SELECT id, nombre FROM departamentos ORDER BY nombre ASC`;
const { rows: municipiosDB } = await sql`SELECT id, nombre, departamento_id FROM municipios ORDER BY nombre ASC`;

let mensaje = "";
let error = false;

if (Astro.request.method === "POST") {
  try {
    if (!isSameOriginRequest(Astro.request, Astro.url)) return new Response(null, { status: 403 });
    const data = await Astro.request.formData();
    if (data.get('plan_action') === 'annual') {
      await sql`UPDATE proveedores SET plan_paid_until = GREATEST(COALESCE(plan_paid_until, NOW()), NOW()) + INTERVAL '1 year' WHERE id = ${id}`;
      return Astro.redirect(Astro.url.pathname + '?plan=anual', 303);
    }
    const nombre = data.get("nombre") as string;
    const descripcion = (data.get("descripcion")?.toString() || "").trim().slice(0, 500);
    const eventosAtendidos = (data.get("eventos_atendidos")?.toString() || "").trim().slice(0, 1200);
    const capacidadEventos = (data.get("capacidad_eventos")?.toString() || "").trim().slice(0, 300);
    const serviciosIncluidos = (data.get("servicios_incluidos")?.toString() || "").trim().slice(0, 1200);
    const instalaciones = (data.get("instalaciones")?.toString() || "").trim().slice(0, 1200);
    const telefono = (data.get("telefono")?.toString() || "").trim();
    if (!/^\d{8}$/.test(telefono)) throw new Error("Ingresa solo los 8 dígitos del teléfono, sin espacios ni letras.");
    const email = (data.get("email")?.toString() || "").trim().toLowerCase();
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new Error("Correo electrónico inválido.");
    const instagramUrl = (data.get("instagram_url")?.toString() || "").trim();
    const tiktokUrl = (data.get("tiktok_url")?.toString() || "").trim();
    const direccion = (data.get("direccion")?.toString() || "").trim().slice(0, 300);
    const isValidSocialUrl = (value: string, domain: string) => {
      if (!value) return true;
      try {
        const url = new URL(value);
        return url.protocol === "https:" && (url.hostname === domain || url.hostname.endsWith("." + domain));
      } catch { return false; }
    };
    if (!isValidSocialUrl(instagramUrl, "instagram.com")) throw new Error("Enlace de Instagram inválido.");
    if (!isValidSocialUrl(tiktokUrl, "tiktok.com")) throw new Error("Enlace de TikTok inválido.");
    const whatsapp = (data.get("whatsapp")?.toString() || "").trim();
    if (!/^\d{8}$/.test(whatsapp)) throw new Error("Ingresa solo los 8 dígitos de WhatsApp, sin espacios ni letras.");
    const categoria = data.get("categoria") as string;
    const depto = data.get("departamento_nombre") as string;
    const municipio = data.get("municipio") as string;
    // Precio temporalmente oculto. Conserva el valor actual del proveedor.
    const precio = Number(p.precio_desde || 0);
    const es_premium = data.get("es_premium") === "on";
    const verificado = data.get("verificado") === "on";
    const activo = data.get("activo") === "on";
    const fotoFile = data.get("foto") as File;

    let fotoUrl = p.imagen_url;

    if (fotoFile && fotoFile.size > 0) {
      const buffer = Buffer.from(await fotoFile.arrayBuffer());
      const optimizedBuffer = await sharp(buffer)
        .resize(1000, 1000, { fit: 'inside', withoutEnlargement: true })
        .webp({ quality: 80 })
        .toBuffer();

      const slugName = nombre.toLowerCase().trim().replace(/[^a-z0-9]/g, '-');
      const fileName = `${categoria}_${slugName}_${Date.now()}.webp`;
      
      const blob = await put(fileName, optimizedBuffer, {
        access: 'public',
        contentType: 'image/webp',
        token: process.env.BLOB_READ_WRITE_TOKEN
      });
      fotoUrl = blob.url;
    }

    // 🚀 ACTUALIZACIÓN CON DETECCIÓN DE DUPLICADOS
    await sql`
      UPDATE proveedores SET 
        nombre = ${nombre},
        descripcion = ${descripcion},
        eventos_atendidos = ${eventosAtendidos},
        capacidad_eventos = ${capacidadEventos},
        servicios_incluidos = ${serviciosIncluidos},
        instalaciones = ${instalaciones},
        telefono = ${telefono},
        email = ${email},
        instagram_url = ${instagramUrl},
        tiktok_url = ${tiktokUrl},
        direccion = ${direccion},
        whatsapp = ${whatsapp},
        municipio = ${municipio},
        departamento = ${depto},
        categoria_slug = ${categoria},
        precio_desde = ${precio},
        imagen_url = ${fotoUrl},
        es_premium = ${es_premium},
        verificado = ${verificado},
        activo = ${activo}
      WHERE id = ${id}
    `;

    if (activo || p.activo) await notifyIndexNow('/' + p.categoria_slug + '/' + p.slug, '/' + categoria + '/' + p.slug);
    return Astro.redirect('/sys-config-gt/proveedores');

  } catch (e: any) {
    console.error(e);
    error = true;
    
    // 🔥 EL MISMO CANDADO QUE EN EL ALTA
    if (e.message.includes('unique_whatsapp') || e.message.includes('duplicate key')) {
      mensaje = "No se pudo actualizar el proveedor: este WhatsApp ya está asignado a otro proveedor. Verifica el número.";
    } else if (e.message.includes("teléfono") || e.message.includes("WhatsApp") || e.message.includes("precio mínimo")) {
      mensaje = e.message;
    } else {
      mensaje = "Error al actualizar. Revisa que no falten datos.";
    }
  }
}
---

<Layout title={`Editar: ${p.nombre}`}>
  <div class="bg-[#F8F9FA] min-h-screen p-6 md:p-12 font-sans text-[#243447]">
    <div class="max-w-4xl mx-auto">
      <header class="mb-10">
        <a href="/sys-config-gt/proveedores" class="text-[10px] font-black uppercase tracking-widest text-[#AD946D]">← Volver al Panel</a>
        <h1 class="text-4xl font-black mt-2 italic">Editar Proveedor ✏️</h1>
      </header>

      <section class="mb-6 rounded-2xl bg-white p-5 text-[#243447]">
        <h2 class="font-bold">Plan del proveedor</h2>
        <p class="mt-2 text-sm">Alta: {formatPlanDate(plan.plan_created_at)} · {plan.status}</p>
        <p class="text-sm">Fin de prueba: {formatPlanDate(plan.trial_ends_at)} · Plan anual hasta: {formatPlanDate(plan.plan_paid_until)}</p>
        {Astro.url.searchParams.has('plan') && <p role="status">Plan anual actualizado.</p>}
        <form method="POST" class="mt-3">
          <button name="plan_action" value="annual" class="rounded-lg bg-[#243447] px-3 py-2 text-sm font-bold text-white">Registrar un año pagado · Q600</button>
        </form>
        {reports[0] && <details class="mt-4">
          <summary class="font-bold">Último reporte mensual</summary>
          <p class="text-sm">{reports[0].sent_at ? 'Enviado por correo' : reports[0].recipient ? 'Pendiente de envío' : 'Disponible para entrega manual · sin correo'}</p>
          <p class="mt-2 whitespace-pre-wrap text-sm">{reports[0].body}</p>
        </details>}
        {inquiries.length > 0 && <div class="mt-4">
          <h3 class="font-bold">Consultas recibidas</h3>
          {inquiries.map(item => <article class="mt-2 border-t pt-2 text-sm">
            <p>{item.sender_name} · {item.sender_email} · {formatPlanDate(item.created_at)}</p>
            <p class="whitespace-pre-wrap">{item.message}</p>
          </article>)}
        </div>}
      </section>
      <form method="POST" enctype="multipart/form-data" class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="md:col-span-1 space-y-6">
          <div class="bg-white p-6 rounded-[30px] shadow-xl border border-gray-100 text-center">
            <img src={p.imagen_url} class="w-full aspect-square object-cover rounded-2xl mb-4 shadow-sm" />
            <input type="file" name="foto" accept="image/*" class="text-[10px] w-full" />
          </div>
          <div class="bg-white p-6 rounded-[30px] shadow-xl border border-gray-100 space-y-4">
             <label class="flex items-center justify-between"><span class="text-[10px] font-black uppercase tracking-widest">¿Premium?</span><input type="checkbox" name="es_premium" checked={p.es_premium} /></label>
             <label class="flex items-center justify-between border-t pt-4"><span class="text-[10px] font-black uppercase tracking-widest">¿Verificado?</span><input type="checkbox" name="verificado" checked={p.verificado} /></label>
             <label class="flex items-center justify-between border-t pt-4"><span class="text-[10px] font-black uppercase tracking-widest">¿Activo?</span><input type="checkbox" name="activo" checked={p.activo} /></label>
          </div>
        </div>

        <div class="md:col-span-2 bg-white p-8 rounded-[40px] shadow-2xl space-y-6">
          <input type="text" name="nombre" value={p.nombre} required class="w-full px-5 py-3 rounded-xl bg-gray-50 border-none placeholder:text-gray-600 placeholder:opacity-100 font-bold" />
          <label class="block text-sm font-bold text-[#243447]">Descripción del proveedor (máximo 500 caracteres)
            <textarea name="descripcion" rows="5" maxlength="500" required class="mt-2 w-full px-5 py-3 rounded-xl bg-gray-50 border-none placeholder:text-gray-600 placeholder:opacity-100 text-sm leading-relaxed">{p.descripcion}</textarea>
            <span class="mt-1 block text-xs font-normal text-gray-500">Resume qué ofrece, los eventos que atiende y su diferencial. Usa datos verificables y máximo 500 caracteres.</span>
          </label>

          <section class="space-y-4 rounded-2xl border border-gray-100 bg-gray-50 p-5">
            <div><h2 class="font-bold text-[#243447]">Información adicional para la ficha pública</h2><p class="mt-1 text-xs text-gray-500">Completa lo que aplique. Solo se mostrará lo que tenga información.</p></div>
            <label class="block text-sm font-semibold">Eventos que atiende
              <textarea name="eventos_atendidos" rows="2" maxlength="1200" placeholder="Bodas, cumpleaños, 15 años, eventos empresariales..." class="mt-2 w-full rounded-xl border-0 bg-white px-4 py-3 text-sm">{p.eventos_atendidos || ""}</textarea>
            </label>
            <label class="block text-sm font-semibold">Capacidad aproximada
              <input type="text" name="capacidad_eventos" maxlength="300" value={p.capacidad_eventos || ""} placeholder="Ej. hasta 150 personas; área interior y jardín" class="mt-2 w-full rounded-xl border-0 bg-white px-4 py-3 text-sm" />
            </label>
            <label class="block text-sm font-semibold">Servicios incluidos o disponibles
              <textarea name="servicios_incluidos" rows="2" maxlength="1200" placeholder="Catering, mobiliario, decoración, música, coordinación..." class="mt-2 w-full rounded-xl border-0 bg-white px-4 py-3 text-sm">{p.servicios_incluidos || ""}</textarea>
            </label>
            <label class="block text-sm font-semibold">Instalaciones y comodidades
              <textarea name="instalaciones" rows="2" maxlength="1200" placeholder="Parqueo, jardín, salón techado, baños, accesibilidad..." class="mt-2 w-full rounded-xl border-0 bg-white px-4 py-3 text-sm">{p.instalaciones || ""}</textarea>
            </label>
          </section>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="tel" name="telefono" value={normalizeGuatemalaPhone(p.telefono || '')} placeholder="8 dígitos, sin espacios" inputmode="numeric" pattern="[0-9]{8}" minlength="8" maxlength="8" required class="w-full px-5 py-3 rounded-xl bg-gray-50 border-none placeholder:text-gray-600 placeholder:opacity-100 font-medium" />
            <input type="tel" name="whatsapp" value={normalizeGuatemalaPhone(p.whatsapp || '')} placeholder="8 dígitos, sin espacios" inputmode="numeric" pattern="[0-9]{8}" minlength="8" maxlength="8" required class="w-full px-5 py-3 rounded-xl bg-gray-50 border-none placeholder:text-gray-600 placeholder:opacity-100 font-bold italic text-[#243447]" />
          </div>

          <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400">Correo electrónico (opcional)
            <input type="email" name="email" maxlength="180" value={p.email || ''} placeholder="contacto@proveedor.com" class="mt-2 w-full px-5 py-3 rounded-xl bg-gray-50 border-none placeholder:text-gray-600 placeholder:opacity-100 font-medium normal-case" />
          </label>

          <section class="rounded-2xl border border-gray-100 bg-gray-50 p-5">
            <h2 class="font-bold text-[#243447]">Redes sociales públicas</h2>
            <p class="mt-1 text-xs text-gray-500">Agrega los enlaces oficiales de este proveedor. Instagram y TikTok aparecerán automáticamente en su ficha pública.</p>
          </section>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400">Instagram (opcional)
              <input type="url" name="instagram_url" maxlength="300" value={p.instagram_url || ''} placeholder="https://www.instagram.com/usuario" class="mt-2 w-full px-5 py-3 rounded-xl bg-gray-50 border-none placeholder:text-gray-600 placeholder:opacity-100 text-sm normal-case font-medium" />
            </label>
            <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400">TikTok (opcional)
              <input type="url" name="tiktok_url" maxlength="300" value={p.tiktok_url || ''} placeholder="https://www.tiktok.com/@usuario" class="mt-2 w-full px-5 py-3 rounded-xl bg-gray-50 border-none placeholder:text-gray-600 placeholder:opacity-100 text-sm normal-case font-medium" />
            </label>
          </div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400">Dirección o referencia pública (opcional)
            <input type="text" name="direccion" maxlength="300" value={p.direccion || ''} placeholder="Escribe solo la dirección o zona que autorizas mostrar" class="mt-2 w-full px-5 py-3 rounded-xl bg-gray-50 border-none placeholder:text-gray-600 placeholder:opacity-100 text-sm normal-case font-medium" />
            <span class="mt-1 block text-[10px] font-medium normal-case text-gray-400">Lo que escribas aquí aparecerá en el perfil público del proveedor.</span>
          </label>

          <div>
            <select name="categoria" class="w-full px-5 py-3 rounded-xl bg-gray-50 border-none placeholder:text-gray-600 placeholder:opacity-100 font-bold">
              {categoriasDB.map(c => <option value={c.slug} selected={c.slug === p.categoria_slug}>{c.nombre}</option>)}
            </select>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <select id="depto-select" required class="w-full px-5 py-3 rounded-xl bg-gray-50 border-none placeholder:text-gray-600 placeholder:opacity-100">
              <option value="">Departamento...</option>
              {departamentosDB.map(d => <option value={d.id} data-nombre={d.nombre} selected={d.nombre === p.departamento}>{d.nombre}</option>)}
            </select>
            <input type="hidden" name="departamento_nombre" id="depto-nombre" value={p.departamento} />
            <select name="municipio" id="muni-select" required class="w-full px-5 py-3 rounded-xl bg-gray-50 border-none placeholder:text-gray-600 placeholder:opacity-100">
              <option value={p.municipio}>{p.municipio}</option>
            </select>
          </div>

          <button type="submit" class="w-full bg-[#243447] text-white py-5 rounded-2xl font-black uppercase text-[11px] shadow-xl hover:bg-black transition-all">Guardar Cambios 🚀</button>
          
          {error && (
            <div class="bg-red-50 p-4 rounded-xl text-center text-red-500 font-bold uppercase text-[10px] border border-red-100 animate-pulse mt-4">
              {mensaje}
            </div>
          )}
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ municipiosDB }}>
    const deptoSelect = document.getElementById('depto-select');
    const muniSelect = document.getElementById('muni-select');
    const deptoNombreInput = document.getElementById('depto-nombre');

    deptoSelect?.addEventListener('change', () => {
      const deptoId = deptoSelect.value;
      const selectedOption = deptoSelect.options[deptoSelect.selectedIndex];
      deptoNombreInput.value = selectedOption.getAttribute('data-nombre');

      const filtrados = municipiosDB.filter(m => m.departamento_id == deptoId);
      muniSelect.innerHTML = filtrados.map(m => `<option value="${m.nombre}">${m.nombre}</option>`).join('');
    });
  </script>
</Layout>
<script is:inline>
  document.querySelectorAll('input[name="telefono"], input[name="whatsapp"]').forEach((input) => {
    input.addEventListener('input', () => { input.value = input.value.replace(/\D/g, '').slice(0, 8); });
  });
</script>
