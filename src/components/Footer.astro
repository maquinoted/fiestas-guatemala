---
// Footer.astro
---

<footer class="bg-[#243447] text-white pt-6 pb-5 px-4 md:pt-16 md:pb-12 md:px-10 text-[11px]">
  <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-5 md:gap-8 font-light">
    
    <div class="col-span-2 md:col-span-1 flex flex-row md:flex-col justify-center md:justify-start items-center md:items-start gap-3 md:gap-4">
      <img src="/Logo-Fiestas-Guatemala.jpg" alt="Logo Fiestas Guatemala" class="h-10 w-10 shrink-0 md:h-14 md:w-14 rounded-xl object-cover shadow-sm ring-1 ring-white/20" />
      <div class="text-left space-y-1 md:space-y-2">
        <p class="leading-relaxed">Boulevard Los Próceres 24-69, zona 10<br/>Ciudad de Guatemala</p>
        <p class="font-bold text-[#d9c69c] text-sm tracking-widest">2302-2201</p>
      </div>
    </div>

    <div class="text-left">
      <p class="text-[#d9c69c] uppercase text-[11px] font-black tracking-[0.16em] mb-2 md:mb-6">Explorar</p>
      <ul class="space-y-1 md:space-y-3 text-white/90 [&_a]:inline-flex [&_a]:min-h-6 [&_a]:items-center md:[&_a]:min-h-0 list-none p-0">
        <li><a href="/departamentos" class="hover:text-white transition-colors no-underline">Departamentos</a></li>
        <li><a href="/mariachis" class="hover:text-white transition-colors no-underline">Mariachis</a></li>
        <li><a href="/salones-de-fiestas" class="hover:text-white transition-colors no-underline">Salones de Fiestas</a></li>
        <li><a href="/pasteles" class="hover:text-white transition-colors no-underline">Pasteles y Repostería</a></li>
      </ul>
    </div>

    <div class="text-left">
      <p class="text-[#d9c69c] uppercase text-[11px] font-black tracking-[0.16em] mb-2 md:mb-6">Comunidad</p>
      <ul class="space-y-1 md:space-y-3 text-white/90 [&_a]:inline-flex [&_a]:min-h-6 [&_a]:items-center md:[&_a]:min-h-0 list-none p-0">
        <li><a href="/nosotros" class="hover:text-white transition-colors no-underline">Sobre Nosotros</a></li>
        <li><a href="/contacto" class="hover:text-white transition-colors no-underline">Anuncia tu Negocio</a></li>
        <li><a href="/proveedores/login" class="hover:text-white transition-colors no-underline">Área de proveedores · Login</a></li>
        <li><a href="/proveedores/registro" class="hover:text-white transition-colors no-underline">Registra tu negocio</a></li>
        <li><a href="/proveedores/terminos" class="hover:text-white transition-colors no-underline">Términos para proveedores</a></li>
        <li><a href="/sos" class="text-[#ffb4ad] hover:text-white transition-colors no-underline font-bold">Botón SOS</a></li>
      </ul>
    </div>

    <div class="col-span-2 md:col-span-1 flex flex-wrap md:flex-col items-center md:items-end justify-between gap-2 md:gap-0 border-t border-white/10 pt-3 md:border-0 md:pt-0">
      <div class="flex gap-2 md:gap-4">
        <a href="#" class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center hover:bg-[#a68a56] hover:border-[#a68a56] transition-all text-white no-underline text-xs">f</a>
        <a href="#" class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center hover:bg-[#a68a56] hover:border-[#a68a56] transition-all text-white no-underline text-xs">i</a>
      </div>
      <div class="text-right">
        <p class="text-[11px] text-white/80 font-black uppercase tracking-widest mb-1">Guatemala, C.A.</p>
        <p class="text-[11px] text-white/80 font-bold uppercase tracking-tighter">© 2026 fiestasGuatemala.com</p>
      </div>
    </div>

  </div>
</footer>