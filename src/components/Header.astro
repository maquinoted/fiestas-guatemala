---
const navigation = [
  { href: '/', label: 'Inicio' },
  { href: '/departamentos', label: 'Departamentos' },
  { href: '/proveedores/login', label: 'Proveedores' },
];
---

<nav aria-label="Navegación principal" class="relative z-20 mx-auto grid max-w-6xl grid-cols-[1fr_auto_1fr] items-center gap-2 border-b border-[#243447]/10 px-3 py-3 lg:grid-cols-[1fr_auto_1fr] lg:gap-5 lg:border-0 lg:px-4 lg:py-8">
  <div class="hidden items-center gap-6 text-xs font-bold uppercase tracking-wider text-[#141510] lg:flex">
    {navigation.map(({ href, label }) => (
      <a href={href} class="whitespace-nowrap hover:text-[#705930]">{label}</a>
    ))}
  </div>

  <div class="lg:hidden"></div>

  <div class="flex min-w-0 flex-col items-center text-center">
    <a href="/" class="flex max-w-full flex-col items-center gap-1.5 no-underline">
      <img
        src="/Logo-Fiestas-Guatemala.jpg"
        alt=""
        class="size-10 rounded-full object-cover shadow-sm lg:size-[85px]"
        width="85"
        height="85"
        fetchpriority="high"
        loading="eager"
      />
      <span class="whitespace-nowrap font-serif text-[clamp(14px,4.5vw,20px)] leading-none tracking-tight text-[#243447] lg:text-[25px]">
        fiestasGuatemala<span class="text-[#705930]">.com</span>
      </span>
    </a>
    <p class="mt-3 hidden text-xs font-bold text-[#705930] lg:block">Aquí Tú Eres el Alma de la Fiesta</p>
  </div>

  <div class="hidden items-center justify-end gap-6 text-xs font-bold uppercase tracking-wider text-[#141510] lg:flex">
    <a href="/cuenta" class="whitespace-nowrap hover:text-[#705930]">Mi cuenta ♡</a>
    <a href="/login" class="rounded-full bg-[#243447] px-6 py-2 text-white hover:bg-black">Login</a>
  </div>

  <div class="flex items-center justify-end gap-2 lg:hidden">
    <a href="/cuenta" aria-label="Mi cuenta y favoritos" class="inline-flex size-12 items-center justify-center rounded-2xl border border-[#243447]/15 bg-white text-[#243447]">
      <span aria-hidden="true" class="text-[32px] leading-none">♡</span>
    </a>
  <details class="group">
    <summary class="flex size-12 cursor-pointer list-none items-center justify-center rounded-2xl bg-[#243447] text-white [&::-webkit-details-marker]:hidden">
      <span class="sr-only">Menú principal</span>
      <span aria-hidden="true" class="grid w-6 gap-[5px] group-open:hidden">
        <span class="h-[3px] rounded-full bg-current"></span>
        <span class="h-[3px] rounded-full bg-current"></span>
        <span class="h-[3px] rounded-full bg-current"></span>
      </span>
      <span aria-hidden="true" class="hidden text-[32px] leading-none group-open:block">×</span>
    </summary>
    <div class="absolute inset-x-3 top-full mt-2 overflow-hidden rounded-2xl border border-[#243447]/10 bg-white p-2 shadow-xl">
      {[...navigation, { href: '/login', label: 'Iniciar sesión' }].map(({ href, label }) => (
        <a href={href} class="flex min-h-12 items-center rounded-xl px-4 text-base font-semibold text-[#243447] hover:bg-[#243447]/5 focus-visible:bg-[#243447]/5">
          {label}
        </a>
      ))}
    </div>
  </details>
  </div>
</nav>
